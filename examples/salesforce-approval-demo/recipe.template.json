{"version": 1, "format": "ocel",
 "inputs": [
  {"id": "opportunities", "sha256": "<Opportunity.csv>"},
  {"id": "stage_history", "sha256": "<OpportunityFieldHistory.csv>"},
  {"id": "orders", "sha256": "<orders.csv>"},
  {"id": "invoices", "sha256": "<invoices.csv>"},
  {"id": "payments", "sha256": "<payments.csv>"},
  {"id": "payment_invoices", "sha256": "<payment_invoices.csv>"}],
 "objects": [
  {"id": "opportunities", "input": "opportunities", "namespace": "salesforce:demo-org", "object_type": "opportunity", "key": ["Id"],
   "attributes": [{"column": "Name", "name": "name"}, {"column": "Amount", "name": "amount"}]},
  {"id": "orders", "input": "orders", "namespace": "erp:demo", "object_type": "order", "key": ["company", "order_number"],
   "attributes": [{"column": "order_value", "name": "order_value"}]},
  {"id": "invoices", "input": "invoices", "namespace": "erp:demo", "object_type": "invoice", "key": ["company", "invoice_number"],
   "attributes": [{"column": "invoice_amount", "name": "invoice_amount"}]},
  {"id": "payments", "input": "payments", "namespace": "erp:demo", "object_type": "payment", "key": ["payment_id"]}],
 "events": [
  {"id": "deal-created", "input": "opportunities", "namespace": "salesforce:demo-org", "key": ["Id"],
   "activity": {"value": "Deal created"}, "timestamp": "CreatedDate",
   "objects": [{"object": "opportunities", "columns": ["Id"], "qualifier": "deal"}]},
  {"id": "stage-changed", "input": "stage_history", "namespace": "salesforce:demo-org", "key": ["Id"],
   "activity": {"column": "NewValue"}, "timestamp": "CreatedDate",
   "objects": [{"object": "opportunities", "columns": ["OpportunityId"], "qualifier": "deal"}]},
  {"id": "order-created", "input": "orders", "namespace": "erp:demo", "key": ["company", "order_number"],
   "activity": {"value": "Order created"}, "timestamp": "created_at",
   "objects": [{"object": "orders", "columns": ["company", "order_number"], "qualifier": "order"},
               {"object": "opportunities", "columns": ["opportunity_id"], "qualifier": "from deal"}]},
  {"id": "invoice-issued", "input": "invoices", "namespace": "erp:demo", "key": ["company", "invoice_number"],
   "activity": {"value": "Invoice issued"}, "timestamp": "issued_at",
   "objects": [{"object": "invoices", "columns": ["company", "invoice_number"], "qualifier": "invoice"},
               {"object": "orders", "columns": ["company", "order_number"], "qualifier": "billed order"}]},
  {"id": "payment-recorded", "input": "payments", "namespace": "erp:demo", "key": ["payment_id"],
   "activity": {"value": "Payment recorded"}, "timestamp": "paid_at",
   "objects": [{"object": "payments", "columns": ["payment_id"], "qualifier": "payment"}]}],
 "relationships": [
  {"id": "order-deal", "input": "orders",
   "source": {"object": "orders", "columns": ["company", "order_number"], "qualifier": "order"},
   "target": {"object": "opportunities", "columns": ["opportunity_id"], "qualifier": "from deal"}},
  {"id": "invoice-order", "input": "invoices",
   "source": {"object": "invoices", "columns": ["company", "invoice_number"], "qualifier": "invoice"},
   "target": {"object": "orders", "columns": ["company", "order_number"], "qualifier": "bills order"}},
  {"id": "payment-invoice", "input": "payment_invoices",
   "source": {"object": "payments", "columns": ["payment_id"], "qualifier": "payment"},
   "target": {"object": "invoices", "columns": ["company", "invoice_number"], "qualifier": "settles invoice"}}],
 "event_links": [
  {"id": "payment-event-invoices", "input": "payment_invoices", "event": "payment-recorded", "event_key": ["payment_id"],
   "target": {"object": "invoices", "columns": ["company", "invoice_number"], "qualifier": "paid invoice"}}]}
