            "column": "USNAM",
            "name": "resource"
          }
        ],
        "objects": [
          {
            "object": "production_order",
            "columns": [
              {
                "column": "OBJNR",
                "start": 2,
                "length": 12
              }
            ],
            "qualifier": "order"
          }
        ]
      },
      {
