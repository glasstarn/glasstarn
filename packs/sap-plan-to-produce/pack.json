{
  "id": "sap-plan-to-produce",
  "version": 1,
  "name": "Plan to produce (SAP ECC and S/4HANA)",
  "system": "SAP ECC or SAP S/4HANA",
  "process": "plan to produce",
  "status": "tested",
  "note": "Tested by the Glasstarn project on SAP S/4HANA 2025 FPS01 trial data: check, build and four order-history comparisons passed. Other SAP releases, customer customizations and unobserved branches still require validation.",
  "case_object_type": "production order",
  "size_check": {
    "ask": "How many production orders were created in the period for the plant?",
    "unit": "production order",
    "steps_per_unit": 8
  },
  "custom_prefixes": [
    "Z*",
    "YY*"
  ],
  "include": [
    "sap-clock"
  ],
  "tables": [
    {
      "name": "AUFK",
      "label": "Order master data",
      "export": "Production orders (AUTYP 10) created in the period for the company code (filter AUTYP, BUKRS and ERDAT).",
      "required": [
        "AUFNR",
        "AUTYP",
        "AUART",
        "ERDAT",
        "ERFZEIT",
        "BUKRS"
      ],
      "fields": [
        "WERKS",
        "ERNAM",
        "OBJNR"
      ],
      "date_field": "ERDAT",
      "scope_field": "BUKRS"
    },
    {
      "name": "AFKO",
      "date_label": "the order is planned to start",
      "label": "Production order headers",
      "export": "Header data of those orders: AUFNR, PLNBEZ (material), GAMNG (quantity), GSTRP and GLTRP (planned start and finish), and the company's own fields.",
      "required": [
        "AUFNR",
        "PLNBEZ",
        "GAMNG",
        "GSTRP",
        "GLTRP"
      ],
      "fields": [
        "DISPO",
        "FEVOR",
        "GMEIN",
        "GSTRI",
        "GETRI"
      ],
      "date_field": "GSTRP"
    },
    {
      "name": "AFPO",
      "noun": "production orders",
      "label": "Production order items",
      "export": "Items of those orders: AUFNR, POSNR, MATNR, PSMNG (quantity), DGLTP (planned finish), PLNUM (the planned order it was converted from, if any), KDAUF and KDPOS (the sales order line it is made for, if any).",
      "required": [
        "AUFNR",
        "POSNR",
        "MATNR",
        "PSMNG",
        "DGLTP",
        "PLNUM",
        "KDAUF",
        "KDPOS"
      ],
      "fields": [
        "WEMNG",
        "LTRMI",
        "DWERK"
      ],
      "object": "production_order",
      "key": [
        "AUFNR"
      ]
    },
    {
      "name": "AFRU",
      "label": "Order confirmations",
      "export": "Confirmations of those orders, including cancelled ones and cancellations (STOKZ, STZHL).",
      "required": [
        "RUECK",
        "RMZHL",
        "AUFNR",
        "VORNR",
        "ERSDA",
        "ERZET",
        "AUERU",
        "STZHL"
      ],
      "fields": [
        "ERNAM",
        "LMNGA",
        "XMNGA",
        "STOKZ",
        "BUDAT",
        "ARBID"
      ],
      "date_field": "ERSDA"
    },
    {
      "name": "MSEG",
      "label": "Goods movements",
      "export": "Material document items posted against those orders (AUFNR filled): component issues (261, 262) and goods receipts (101, 102).",
      "required": [
        "MBLNR",
        "MJAHR",
        "ZEILE",
        "BWART",
        "AUFNR",
        "MATNR",
        "MENGE",
        "CPUDT_MKPF",
        "CPUTM_MKPF"
      ],
      "fields": [
        "WERKS",
        "LGORT",
        "MEINS",
        "USNAM_MKPF"
      ],
      "date_field": "CPUDT_MKPF",
      "optional": true
    },
    {
      "name": "JCDS",
      "label": "Status changes",
      "export": "Status change documents of those orders (OBJNR = OR + order number), at least for statuses I0002 (released), I0045 (technically completed), I0046 (closed) and I0076 (deletion flag).",
      "required": [
        "OBJNR",
        "STAT",
        "CHGNR",
        "UDATE",
        "UTIME",
        "INACT"
      ],
      "fields": [
        "USNAM",
        "CHIND"
      ],
      "date_field": "UDATE",
      "optional": true
    }
  ],
  "unique": [
    {
      "id": "one-order",
      "table": "AUFK",
      "columns": [
        "AUFNR"
      ],
      "label": "orders listed once"
    },
    {
      "id": "one-production-order-header",
      "table": "AFKO",
      "columns": [
        "AUFNR"
      ],
      "label": "order headers listed once"
    },
    {
      "id": "one-production-order-item",
      "table": "AFPO",
      "columns": [
        "AUFNR",
        "POSNR"
      ],
      "label": "order items listed once"
    },
    {
      "id": "one-confirmation",
      "table": "AFRU",
      "columns": [
        "RUECK",
        "RMZHL"
      ],
      "label": "confirmations listed once"
    },
    {
      "id": "one-goods-movement",
      "table": "MSEG",
      "columns": [
        "MBLNR",
        "MJAHR",
        "ZEILE"
      ],
      "label": "goods movements listed once"
    },
    {
      "id": "one-status-change",
      "table": "JCDS",
      "columns": [
        "OBJNR",
        "STAT",
        "CHGNR"
      ],
      "label": "status changes listed once"
    }
  ],
  "checks": [
    {
      "id": "orders-have-headers",
      "label": "production orders whose header is in the export",
      "from": {
        "table": "AUFK",
        "columns": [
          "AUFNR"
        ],
        "where": [
          {
            "column": "AUTYP",
            "in": [
              "10"
            ]
          }
        ]
      },
      "to": {
        "table": "AFKO",
        "columns": [
          "AUFNR"
        ]
      },
      "expect": "all"
    },
    {
      "id": "headers-have-orders",
      "label": "order headers whose order is in the export",
      "from": {
        "table": "AFKO",
        "columns": [
          "AUFNR"
        ]
      },
      "to": {
        "table": "AUFK",
        "columns": [
          "AUFNR"
        ]
      },
      "expect": "all"
    },
    {
      "id": "orders-have-items",
      "label": "production orders whose item is in the export",
      "from": {
        "table": "AFKO",
        "columns": [
          "AUFNR"
        ]
      },
      "to": {
        "table": "AFPO",
        "columns": [
          "AUFNR"
        ],
        "where": [
          {
            "column": "POSNR",
            "in": [
              "0001"
            ]
          }
        ]
      },
      "expect": "all"
    },
    {
      "id": "confirmations-have-orders",
      "label": "confirmations whose order is in the export",
      "from": {
        "table": "AFRU",
        "columns": [
          "AUFNR"
        ]
      },
      "to": {
        "table": "AFKO",
        "columns": [
          "AUFNR"
        ]
      },
      "expect": "all"
    },
    {
      "id": "movements-have-orders",
      "label": "goods movements whose order is in the export",
      "from": {
        "table": "MSEG",
        "columns": [
          "AUFNR"
        ],
        "where": [
          {
            "column": "AUFNR",
            "not_in": [
              ""
            ]
          }
        ]
      },
      "to": {
        "table": "AFKO",
        "columns": [
          "AUFNR"
        ]
      },
      "expect": "all"
    },
    {
      "id": "statuses-have-orders",
      "label": "status changes whose order is in the export",
      "from": {
        "table": "JCDS",
        "columns": [
          {
            "column": "OBJNR",
            "start": 2,
            "length": 12
          }
        ]
      },
      "to": {
        "table": "AFKO",
        "columns": [
          "AUFNR"
        ]
      },
      "expect": "all"
    }
  ],
  "recipe": {
    "objects": [
      {
        "id": "production_order",
        "input": "AFPO",
        "namespace": "sap",
        "object_type": "production order",
        "key": [
          "AUFNR"
        ],
        "attributes": [
          {
            "column": "MATNR",
            "name": "material"
          },
          {
            "column": "PSMNG",
            "name": "quantity"
          },
          {
            "column": "DGLTP",
            "name": "planned finish"
          },
          {
            "column": "PLNUM",
            "name": "planned order"
          },
          {
            "column": "KDAUF",
            "name": "sales order"
          },
          {
            "column": "KDPOS",
            "name": "sales order item"
          }
        ],
        "where": [
          {
            "column": "POSNR",
            "in": [
              "0001"
            ]
          }
        ]
      }
    ],
    "events": [
