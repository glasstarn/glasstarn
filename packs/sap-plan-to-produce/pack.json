        "timestamp": {
          "date": "ERDAT",
          "offset": "{setting:offset}",
          "time": "ERFZEIT"
        },
        "attributes": [
          {
            "column": "AUART",
            "name": "order type"
          },
          {
            "column": "WERKS",
            "name": "plant"
          },
          {
            "column": "ERNAM",
            "name": "resource"
          }
        ],
        "objects": [
          {
            "object": "production_order",
            "columns": [
              "AUFNR"
            ],
            "qualifier": "order"
          }
        ]
      },
      {
