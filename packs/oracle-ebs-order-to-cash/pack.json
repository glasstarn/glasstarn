            ]
          }
        ],
        "activity": {
          "value": "Cancel order line"
        },
        "timestamp": {
          "date": "LAST_UPDATE_DATE",
          "offset": "{setting:offset}"
        },
        "objects": [
          {
            "object": "ora_so_line",
            "columns": [
              "LINE_ID"
            ],
            "qualifier": "sales order line"
          },
          {
            "object": "ora_so",
            "columns": [
              "HEADER_ID"
            ],
            "qualifier": "sales order"
          }
        ]
      },
      {
        "id": "ora_trx_created",
        "input": "RA_CUSTOMER_TRX_ALL",
        "namespace": "oracle",
        "key": [
          "CUSTOMER_TRX_ID"
        ],
        "activity": {
          "value": "Create customer invoice"
        },
        "timestamp": {
          "date": "CREATION_DATE",
          "offset": "{setting:offset}"
        },
        "objects": [
          {
            "object": "ora_trx",
            "columns": [
