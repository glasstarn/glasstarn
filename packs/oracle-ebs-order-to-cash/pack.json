        ],
        "where": [
          {
            "column": "STATUS",
            "in": [
              "APP"
            ]
          },
          {
            "column": "DISPLAY",
            "in": [
              "Y"
            ]
          }
        ],
        "activity": {
          "value": "Receive customer payment"
        },
        "timestamp": {
          "date": "CREATION_DATE",
          "offset": "{setting:offset}"
        },
        "attributes": [
          {
            "column": "AMOUNT_APPLIED",
            "name": "amount"
          }
        ],
        "objects": [
          {
            "object": "ora_trx",
            "columns": [
              "APPLIED_CUSTOMER_TRX_ID"
            ],
            "qualifier": "customer invoice"
          }
        ]
      },
      {
