{
  "id": "oracle-ebs-order-to-cash",
  "version": 1,
  "name": "Order to cash (Oracle E-Business Suite)",
  "system": "Oracle E-Business Suite (R12)",
  "process": "order to cash",
  "status": "untested",
  "note": "Written by the Glasstarn project from public knowledge of the Oracle Order Management (OE) and Receivables tables. Not yet confirmed on a real system; tested only on made-up tables in the standard layout.",
  "case_object_type": "sales order line",
  "size_check": {
    "ask": "How many sales order lines were created in the period?",
    "unit": "sales order line",
    "steps_per_unit": 4
  },
  "custom_prefixes": [
    "ATTRIBUTE*"
  ],
  "settings": [
    {
      "id": "offset",
      "question": "What time zone is the Oracle database server set to? E-Business Suite stores times without a time zone. Give it as an offset from UTC, for example -05:00.",
      "example": "-05:00"
    }
  ],
  "tables": [
    {
      "name": "OE_ORDER_HEADERS_ALL",
      "noun": "sales orders",
      "date_label": "the order was created",
      "label": "Sales orders",
      "export": "Sales orders created in the period for the operating unit: HEADER_ID, ORDER_NUMBER, SOLD_TO_ORG_ID, ORG_ID, CREATION_DATE, BOOKED_FLAG, BOOKED_DATE and FLOW_STATUS_CODE. Export with SQL from the APPS schema. Dates with their time, as YYYY-MM-DD HH:MM:SS.",
      "required": [
        "HEADER_ID",
        "ORDER_NUMBER",
        "ORG_ID",
        "CREATION_DATE",
        "BOOKED_FLAG",
        "BOOKED_DATE"
      ],
      "fields": [
        "SOLD_TO_ORG_ID",
        "FLOW_STATUS_CODE",
        "ORDER_TYPE_ID"
      ],
      "date_field": "CREATION_DATE",
      "object": "ora_so",
      "key": [
        "HEADER_ID"
      ],
      "scope_field": "ORG_ID"
    },
    {
      "name": "OE_ORDER_LINES_ALL",
      "noun": "sales order lines",
      "label": "Sales order lines",
      "export": "The lines of those orders: LINE_ID, HEADER_ID, LINE_NUMBER, INVENTORY_ITEM_ID, ORDERED_QUANTITY, CREATION_DATE, ACTUAL_SHIPMENT_DATE, CANCELLED_FLAG and LAST_UPDATE_DATE.",
      "required": [
        "LINE_ID",
        "HEADER_ID",
        "ORDERED_QUANTITY",
        "CREATION_DATE",
        "ACTUAL_SHIPMENT_DATE",
        "CANCELLED_FLAG",
        "LAST_UPDATE_DATE"
      ],
      "fields": [
        "LINE_NUMBER",
        "INVENTORY_ITEM_ID",
        "FLOW_STATUS_CODE"
      ],
      "object": "ora_so_line",
      "key": [
        "LINE_ID"
      ]
    },
    {
      "name": "OE_ORDER_HOLDS_ALL",
      "label": "Order holds",
      "export": "Holds on those orders or lines: ORDER_HOLD_ID, HEADER_ID, LINE_ID (blank for an order hold), CREATION_DATE, RELEASED_FLAG and HOLD_RELEASE_ID.",
      "required": [
        "ORDER_HOLD_ID",
        "HEADER_ID",
        "LINE_ID",
        "CREATION_DATE",
        "RELEASED_FLAG",
        "HOLD_RELEASE_ID"
      ],
      "fields": [
        "HOLD_SOURCE_ID"
      ],
      "date_field": "CREATION_DATE",
      "optional": true
    },
    {
      "name": "OE_HOLD_RELEASES",
      "label": "Hold releases",
      "export": "The releases of those holds: HOLD_RELEASE_ID, CREATION_DATE and RELEASE_REASON_CODE.",
      "required": [
        "HOLD_RELEASE_ID",
        "CREATION_DATE"
      ],
      "fields": [
        "RELEASE_REASON_CODE"
      ],
      "date_field": "CREATION_DATE",
      "optional": true
    },
    {
      "name": "RA_CUSTOMER_TRX_ALL",
      "noun": "customer invoices",
      "label": "Customer invoices",
      "export": "Invoices for those orders: CUSTOMER_TRX_ID, TRX_NUMBER, TRX_DATE, CREATION_DATE and BILL_TO_CUSTOMER_ID. Dates with their time, as YYYY-MM-DD HH:MM:SS.",
      "required": [
        "CUSTOMER_TRX_ID",
        "TRX_NUMBER",
        "CREATION_DATE"
      ],
      "fields": [
        "TRX_DATE",
        "BILL_TO_CUSTOMER_ID",
        "CUST_TRX_TYPE_ID"
      ],
      "date_field": "CREATION_DATE",
      "object": "ora_trx",
      "key": [
        "CUSTOMER_TRX_ID"
      ]
    },
    {
      "name": "RA_CUSTOMER_TRX_LINES_ALL",
      "label": "Customer invoice lines",
      "export": "The lines of those invoices: CUSTOMER_TRX_LINE_ID, CUSTOMER_TRX_ID, LINE_TYPE, INTERFACE_LINE_CONTEXT and the INTERFACE_LINE_ATTRIBUTE fields (they name the order line billed).",
      "required": [
        "CUSTOMER_TRX_LINE_ID",
        "CUSTOMER_TRX_ID",
        "LINE_TYPE",
        "INTERFACE_LINE_ATTRIBUTE6"
      ],
      "fields": [
        "INTERFACE_LINE_CONTEXT",
        "EXTENDED_AMOUNT"
      ]
    },
    {
      "name": "AR_RECEIVABLE_APPLICATIONS_ALL",
      "label": "Receipt applications",
      "export": "Cash receipts applied to those invoices: RECEIVABLE_APPLICATION_ID, APPLIED_CUSTOMER_TRX_ID, CASH_RECEIPT_ID, STATUS, DISPLAY, AMOUNT_APPLIED and CREATION_DATE. Dates with their time, as YYYY-MM-DD HH:MM:SS.",
      "required": [
        "RECEIVABLE_APPLICATION_ID",
        "APPLIED_CUSTOMER_TRX_ID",
        "STATUS",
        "DISPLAY",
        "CREATION_DATE"
      ],
      "fields": [
        "CASH_RECEIPT_ID",
        "AMOUNT_APPLIED",
        "APPLY_DATE"
      ],
      "date_field": "CREATION_DATE",
      "optional": true
    }
  ],
  "unique": [
    {
      "id": "one-oe-order-headers-all",
      "table": "OE_ORDER_HEADERS_ALL",
      "columns": [
        "HEADER_ID"
      ],
      "label": "sales orders listed once"
    },
    {
      "id": "one-oe-order-lines-all",
      "table": "OE_ORDER_LINES_ALL",
      "columns": [
        "LINE_ID"
      ],
      "label": "sales order lines listed once"
    },
    {
      "id": "one-oe-order-holds-all",
      "table": "OE_ORDER_HOLDS_ALL",
      "columns": [
        "ORDER_HOLD_ID"
      ],
      "label": "order holds listed once"
    },
    {
      "id": "one-oe-hold-releases",
      "table": "OE_HOLD_RELEASES",
      "columns": [
        "HOLD_RELEASE_ID"
      ],
      "label": "hold releases listed once"
    },
    {
      "id": "one-ra-customer-trx-all",
      "table": "RA_CUSTOMER_TRX_ALL",
      "columns": [
        "CUSTOMER_TRX_ID"
      ],
      "label": "customer invoices listed once"
    },
    {
      "id": "one-ra-customer-trx-lines-all",
      "table": "RA_CUSTOMER_TRX_LINES_ALL",
      "columns": [
        "CUSTOMER_TRX_LINE_ID"
      ],
      "label": "customer invoice lines listed once"
    },
    {
      "id": "one-ar-receivable-applications-all",
      "table": "AR_RECEIVABLE_APPLICATIONS_ALL",
      "columns": [
        "RECEIVABLE_APPLICATION_ID"
      ],
      "label": "receipt applications listed once"
    }
  ],
  "checks": [
    {
      "id": "lines-have-orders",
      "label": "order lines whose order is in the export",
      "from": {
        "table": "OE_ORDER_LINES_ALL",
        "columns": [
          "HEADER_ID"
        ]
      },
      "to": {
        "table": "OE_ORDER_HEADERS_ALL",
        "columns": [
          "HEADER_ID"
        ]
      },
      "expect": "all"
    },
    {
      "id": "invoice-lines-have-invoices",
      "label": "invoice lines whose invoice is in the export",
      "from": {
        "table": "RA_CUSTOMER_TRX_LINES_ALL",
        "columns": [
          "CUSTOMER_TRX_ID"
        ]
      },
      "to": {
        "table": "RA_CUSTOMER_TRX_ALL",
        "columns": [
          "CUSTOMER_TRX_ID"
        ]
      },
      "expect": "all"
    },
    {
      "id": "invoice-lines-have-order-lines",
      "label": "invoice lines billed from an order line in the export",
      "from": {
        "table": "RA_CUSTOMER_TRX_LINES_ALL",
        "columns": [
          "INTERFACE_LINE_ATTRIBUTE6"
        ],
        "where": [
          {
            "column": "LINE_TYPE",
            "in": [
              "LINE"
            ]
          },
          {
            "column": "INTERFACE_LINE_ATTRIBUTE6",
            "not_in": [
              ""
            ]
          }
        ]
      },
      "to": {
        "table": "OE_ORDER_LINES_ALL",
        "columns": [
          "LINE_ID"
        ]
      },
      "expect": "most",
      "threshold": 0.95,
      "question": {
        "text": "{missing} of {total} invoice lines were billed from orders created before the period. Keep them without their order, or re-export with the older orders?",
        "options": [
          {
            "id": "keep",
            "label": "Keep them without their order"
          },
          {
            "id": "re-export",
            "label": "Re-export with the older orders"
          }
        ],
        "recommended": "keep"
      }
    },
    {
      "id": "applications-have-invoices",
      "label": "receipt applications whose invoice is in the export",
      "from": {
        "table": "AR_RECEIVABLE_APPLICATIONS_ALL",
        "columns": [
          "APPLIED_CUSTOMER_TRX_ID"
        ],
        "where": [
          {
            "column": "STATUS",
            "in": [
              "APP"
            ]
          }
        ]
      },
      "to": {
        "table": "RA_CUSTOMER_TRX_ALL",
        "columns": [
          "CUSTOMER_TRX_ID"
        ]
      },
      "expect": "all"
    },
    {
      "id": "holds-have-orders",
      "label": "holds whose order is in the export",
      "from": {
        "table": "OE_ORDER_HOLDS_ALL",
        "columns": [
          "HEADER_ID"
        ]
      },
      "to": {
        "table": "OE_ORDER_HEADERS_ALL",
        "columns": [
          "HEADER_ID"
        ]
      },
      "expect": "all"
    },
    {
      "id": "released-holds-have-releases",
      "label": "released holds whose release is in the export",
      "from": {
        "table": "OE_ORDER_HOLDS_ALL",
        "columns": [
          "HOLD_RELEASE_ID"
        ],
        "where": [
          {
            "column": "RELEASED_FLAG",
            "in": [
              "Y"
            ]
          }
        ]
      },
      "to": {
        "table": "OE_HOLD_RELEASES",
        "columns": [
          "HOLD_RELEASE_ID"
        ]
      },
      "expect": "all"
    }
  ],
  "recipe": {
    "version": 1,
    "format": "ocel",
    "objects": [
      {
        "id": "ora_so",
        "input": "OE_ORDER_HEADERS_ALL",
        "namespace": "oracle",
        "object_type": "sales order",
        "key": [
          "HEADER_ID"
        ],
        "attributes": [
          {
            "column": "ORDER_NUMBER",
            "name": "order number"
          }
        ]
      },
      {
        "id": "ora_so_line",
        "input": "OE_ORDER_LINES_ALL",
        "namespace": "oracle",
        "object_type": "sales order line",
        "key": [
          "LINE_ID"
        ],
        "attributes": [
          {
            "column": "ORDERED_QUANTITY",
            "name": "quantity"
          },
          {
            "column": "INVENTORY_ITEM_ID",
            "name": "item"
          }
        ]
      },
      {
        "id": "ora_trx",
        "input": "RA_CUSTOMER_TRX_ALL",
        "namespace": "oracle",
        "object_type": "customer invoice",
        "key": [
          "CUSTOMER_TRX_ID"
        ],
        "attributes": [
          {
            "column": "TRX_NUMBER",
            "name": "invoice number"
          }
        ]
      }
    ],
    "events": [
      {
        "id": "ora_so_created",
        "input": "OE_ORDER_HEADERS_ALL",
        "namespace": "oracle",
        "key": [
          "HEADER_ID"
        ],
        "activity": {
          "value": "Create sales order"
        },
        "timestamp": {
          "date": "CREATION_DATE",
          "offset": "{setting:offset}"
        },
        "objects": [
          {
            "object": "ora_so",
            "columns": [
              "HEADER_ID"
            ],
            "qualifier": "sales order"
          }
        ]
      },
      {
        "id": "ora_so_booked",
        "input": "OE_ORDER_HEADERS_ALL",
        "namespace": "oracle",
        "key": [
          "HEADER_ID"
        ],
        "where": [
          {
            "column": "BOOKED_FLAG",
            "in": [
              "Y"
            ]
          }
        ],
        "activity": {
          "value": "Book sales order"
        },
        "timestamp": {
          "date": "BOOKED_DATE",
          "offset": "{setting:offset}"
        },
        "optional_timestamp": true,
        "objects": [
          {
            "object": "ora_so",
            "columns": [
              "HEADER_ID"
            ],
            "qualifier": "sales order"
          }
        ]
      },
      {
        "id": "ora_line_shipped",
        "input": "OE_ORDER_LINES_ALL",
        "namespace": "oracle",
        "key": [
          "LINE_ID"
        ],
        "activity": {
          "value": "Ship goods"
        },
        "timestamp": {
          "date": "ACTUAL_SHIPMENT_DATE",
          "offset": "{setting:offset}"
        },
        "optional_timestamp": true,
        "objects": [
          {
            "object": "ora_so_line",
            "columns": [
              "LINE_ID"
            ],
            "qualifier": "sales order line"
          },
          {
            "object": "ora_so",
            "columns": [
              "HEADER_ID"
            ],
            "qualifier": "sales order"
          }
        ]
      },
      {
        "id": "ora_line_cancelled",
        "input": "OE_ORDER_LINES_ALL",
        "namespace": "oracle",
        "key": [
