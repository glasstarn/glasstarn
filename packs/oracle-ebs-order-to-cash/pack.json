        ],
        "activity": {
          "value": "Put order on hold"
        },
        "timestamp": {
          "date": "CREATION_DATE",
          "offset": "{setting:offset}"
        },
        "objects": [
          {
            "object": "ora_so",
            "columns": [
              "HEADER_ID"
            ],
            "qualifier": "sales order"
          }
        ]
      },
      {
        "id": "ora_hold_released",
        "input": "OE_ORDER_HOLDS_ALL",
        "namespace": "oracle",
        "key": [
          "ORDER_HOLD_ID"
        ],
        "where": [
          {
            "column": "RELEASED_FLAG",
            "in": [
              "Y"
            ]
          }
        ],
        "activity": {
          "value": "Release order hold"
        },
        "lookup": {
          "input": "OE_HOLD_RELEASES",
          "key": [
            "HOLD_RELEASE_ID"
          ],
          "matching": [
            "HOLD_RELEASE_ID"
          ],
          "columns": [
            "CREATION_DATE"
          ]
        },
        "timestamp": {
          "date": "CREATION_DATE",
          "offset": "{setting:offset}"
        },
        "objects": [
          {
            "object": "ora_so",
            "columns": [
              "HEADER_ID"
            ],
            "qualifier": "sales order"
          }
        ]
