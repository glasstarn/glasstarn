          }
        ],
        "activity": {
          "column": "NewValue",
          "prefix": "Stage: "
        },
        "timestamp": "CreatedDate",
        "attributes": [
          {
            "column": "OldValue",
            "name": "old value"
          },
          {
            "column": "NewValue",
            "name": "new value"
          }
        ],
        "objects": [
          {
            "object": "ncino_loan",
            "columns": [
              "ParentId"
            ],
            "qualifier": "loan"
          }
        ]
      },
      {
        "id": "ncino_status_changed",
        "input": "LLC_BI__Loan__History",
        "namespace": "salesforce",
        "key": [
          "Id"
        ],
        "where": [
          {
            "column": "Field",
            "in": [
              "LLC_BI__Status__c"
            ]
          }
        ],
        "activity": {
          "column": "NewValue",
          "prefix": "Status: "
        },
        "timestamp": "CreatedDate",
        "attributes": [
          {
            "column": "OldValue",
            "name": "old value"
          },
          {
            "column": "NewValue",
            "name": "new value"
          }
        ],
        "objects": [
          {
            "object": "ncino_loan",
            "columns": [
              "ParentId"
            ],
            "qualifier": "loan"
          }
        ]
      },
      {
        "id": "ncino_amount_changed",
        "input": "LLC_BI__Loan__History",
        "namespace": "salesforce",
        "key": [
          "Id"
        ],
        "where": [
          {
            "column": "Field",
            "in": [
              "LLC_BI__Amount__c"
            ]
          }
        ],
        "activity": {
          "value": "Change loan amount"
        },
        "timestamp": "CreatedDate",
        "attributes": [
          {
            "column": "OldValue",
            "name": "old value"
          },
          {
            "column": "NewValue",
            "name": "new value"
          }
        ],
        "objects": [
          {
            "object": "ncino_loan",
            "columns": [
              "ParentId"
            ],
            "qualifier": "loan"
          }
        ]
      },
      {
        "id": "ncino_submitted",
        "input": "ProcessInstanceStep",
        "namespace": "salesforce",
        "key": [
