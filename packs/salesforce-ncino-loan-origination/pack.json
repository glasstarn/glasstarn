        ],
        "where": [
          {
            "column": "StepStatus",
            "in": [
              "Rejected"
            ]
          }
        ],
        "activity": {
          "value": "Decline loan"
        },
        "lookup": {
          "input": "ProcessInstance",
          "key": [
            "Id"
          ],
          "matching": [
            "ProcessInstanceId"
          ],
          "columns": [
            "TargetObjectId"
          ],
          "optional": true
        },
        "timestamp": "CreatedDate",
        "attributes": [
          {
            "column": "ActorId",
            "name": "resource"
          }
        ],
        "objects": [
          {
            "object": "ncino_loan",
            "columns": [
              "TargetObjectId"
            ],
