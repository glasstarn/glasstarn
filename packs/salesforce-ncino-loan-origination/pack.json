            ]
          }
        ],
        "activity": {
          "value": "Submit for credit approval"
        },
        "lookup": {
          "input": "ProcessInstance",
          "key": [
            "Id"
          ],
          "matching": [
            "ProcessInstanceId"
          ],
          "columns": [
            "TargetObjectId"
          ],
          "optional": true
        },
        "timestamp": "CreatedDate",
        "attributes": [
          {
            "column": "ActorId",
            "name": "resource"
          }
        ],
        "objects": [
          {
            "object": "ncino_loan",
