            ]
          }
        ],
        "activity": {
          "value": "Recall approval request"
        },
        "lookup": {
          "input": "ProcessInstance",
          "key": [
            "Id"
          ],
          "matching": [
            "ProcessInstanceId"
          ],
          "columns": [
            "TargetObjectId"
          ],
          "optional": true
        },
        "timestamp": "CreatedDate",
        "attributes": [
          {
            "column": "ActorId",
            "name": "resource"
          }
        ],
        "objects": [
          {
            "object": "ncino_loan",
            "columns": [
              "TargetObjectId"
            ],
            "qualifier": "loan"
          }
        ]
      }
    ]
  }
