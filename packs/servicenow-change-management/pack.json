{
  "id": "servicenow-change-management",
  "version": 1,
  "name": "Change management (ServiceNow)",
  "system": "ServiceNow",
  "process": "change management",
  "status": "tested",
  "note": "Written by the Glasstarn project from public knowledge of ServiceNow's Table API, its standard tables and the audit history (sys_audit). Checked on a real ServiceNow instance on 2026-10-15 with planted records; see the README. Steps come from audited fields; a field excluded from auditing leaves no steps.",
  "case_object_type": "change request",
  "size_check": {
    "ask": "How many change requests were raised in the period?",
    "unit": "change request",
    "steps_per_unit": 12
  },
  "custom_prefixes": [
    "u_"
  ],
  "tables": [
    {
      "name": "ServiceNowChangeRequest",
      "noun": "change requests",
      "date_label": "the change was raised",
      "label": "ServiceNow change requests",
      "export": "Change requests with activity in the period, from the ServiceNow extract (table change_request): sys_id, number, created, state, type, risk, approval, assignment_group, start_date, end_date and the company's own fields, with state, type, approval and assignment group labels.",
      "required": [
        "sys_id",
        "number",
        "created",
        "state",
        "type",
        "approval",
        "state_label",
        "type_label",
        "approval_label"
      ],
      "fields": [
        "risk",
        "assignment_group",
        "start_date",
        "end_date",
        "assignment_group_label"
      ],
      "date_field": "created",
      "object": "sn_change",
      "key": [
        "sys_id"
      ]
    },
    {
      "name": "ServiceNowChangeTask",
      "noun": "change tasks",
      "date_label": "the task was created",
      "label": "ServiceNow change tasks",
      "export": "The change tasks of those change requests (table change_task, by change_request): sys_id, number, created, change_request, state, assignment_group, with state and assignment group labels.",
      "required": [
        "sys_id",
        "number",
        "created",
        "change_request",
        "state",
        "state_label"
      ],
      "fields": [
        "assignment_group",
        "assignment_group_label"
      ],
      "date_field": "created",
      "object": "sn_change_task",
      "key": [
        "sys_id"
      ]
    },
    {
      "name": "ServiceNowAudit",
      "label": "ServiceNow audit history",
      "export": "The audit history (sys_audit) of those records, one row per changed field, from the ServiceNow extract: table, record, audit_id, created, user, field, old and new stored values and their display labels.",
      "required": [
        "table",
        "record",
        "audit_id",
        "created",
        "field",
        "old_value",
        "old_label",
        "new_value",
        "new_label"
      ],
      "fields": [
        "user"
      ],
      "date_field": "created"
    }
  ],
  "unique": [
    {
      "id": "one-ServiceNowChangeRequest",
      "table": "ServiceNowChangeRequest",
      "columns": [
        "sys_id"
      ],
      "label": "change requests listed once"
    },
    {
      "id": "one-ServiceNowChangeTask",
      "table": "ServiceNowChangeTask",
      "columns": [
        "sys_id"
      ],
      "label": "change tasks listed once"
    },
    {
      "id": "one-audit-row",
      "table": "ServiceNowAudit",
      "columns": [
        "audit_id"
      ],
      "label": "audit rows listed once"
    }
  ],
  "checks": [
    {
      "id": "audit-has-change-request",
      "label": "audit rows whose change request is in the extract",
      "from": {
        "table": "ServiceNowAudit",
        "columns": [
          "record"
        ],
        "where": [
          {
            "column": "table",
            "in": [
              "change_request"
            ]
          }
        ]
      },
      "to": {
        "table": "ServiceNowChangeRequest",
        "columns": [
          "sys_id"
        ]
      },
      "expect": "all"
    },
    {
      "id": "audit-has-change-task",
      "label": "audit rows whose change task is in the extract",
      "from": {
        "table": "ServiceNowAudit",
        "columns": [
          "record"
        ],
        "where": [
          {
            "column": "table",
            "in": [
              "change_task"
            ]
          }
        ]
      },
      "to": {
        "table": "ServiceNowChangeTask",
        "columns": [
          "sys_id"
        ]
      },
      "expect": "all"
    },
    {
      "id": "tasks-have-changes",
      "label": "change tasks whose change request is in the extract",
      "from": {
        "table": "ServiceNowChangeTask",
        "columns": [
          "change_request"
        ]
      },
      "to": {
        "table": "ServiceNowChangeRequest",
        "columns": [
          "sys_id"
        ]
      },
      "expect": "all"
    }
  ],
