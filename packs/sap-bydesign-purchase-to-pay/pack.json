    {
      "name": "SupplierInvoiceItem",
      "label": "Supplier invoice items",
      "export": "Their items, with the order item each one charges: SupplierInvoiceID (the document), ID (the item), ProductID, Quantity, PurchaseOrderID, PurchaseOrderItemID.",
      "required": [
        "SupplierInvoiceID",
        "ID",
        "ProductID",
        "Quantity",
        "PurchaseOrderID",
        "PurchaseOrderItemID"
      ],
      "fields": [
        "NetAmount"
      ]
    },
    {
      "name": "SupplierPayment",
