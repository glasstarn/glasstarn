  "process": "purchase to pay",
  "status": "untested",
  "note": "Written by the Glasstarn project from public knowledge of the SAP Business ByDesign business objects and their OData services. Not yet confirmed on a real tenant; tested only on made-up extracts. File and field names follow the business objects; the tenant's own OData or report exports may name them differently.",
  "case_object_type": "purchase order line",
  "size_check": {
    "ask": "How many purchase order lines were created in the period?",
    "unit": "purchase order line",
    "steps_per_unit": 4
  },
  "custom_prefixes": [
    "*_KUT"
  ],
  "tables": [
    {
      "name": "PurchaseRequest",
      "label": "Purchase requests",
      "export": "Purchase requests created in the period: ID, CreationDateTime, SellerPartyID, LifeCycleStatusCode and the tenant's own fields. Times in UTC as the OData services return them (2026-01-05T14:30:00Z).",
      "required": [
        "ID",
        "CreationDateTime"
      ],
      "fields": [
        "SellerPartyID",
        "LifeCycleStatusCode",
        "CurrencyCode",
        "TotalNetAmount"
      ],
      "date_field": "CreationDateTime",
      "optional": true,
      "object": "byd_p_request",
      "key": [
        "ID"
      ],
      "noun": "purchase requests"
    },
    {
      "name": "PurchaseRequestItem",
      "label": "Purchase request items",
      "export": "The items of those purchase requests: PurchaseRequestID (the document), ID (the item), ProductID, Quantity.",
      "required": [
        "PurchaseRequestID",
        "ID",
        "ProductID",
        "Quantity"
      ],
      "fields": [
        "NetAmount"
      ],
      "optional": true
    },
    {
      "name": "PurchaseOrder",
      "label": "Purchase orders",
