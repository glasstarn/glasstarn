        "ID",
        "CreationDateTime"
      ],
      "fields": [
        "SellerPartyID",
        "LifeCycleStatusCode",
        "CurrencyCode",
        "TotalNetAmount"
      ],
      "date_field": "CreationDateTime"
    },
    {
      "name": "GoodsAndServiceAcknowledgementItem",
      "label": "Goods receipt lines",
      "export": "Their items, with the order item each one is for: GoodsAndServiceAcknowledgementID (the document), ID (the item), ProductID, Quantity, PurchaseOrderID, PurchaseOrderItemID.",
      "required": [
        "GoodsAndServiceAcknowledgementID",
        "ID",
        "ProductID",
        "Quantity",
        "PurchaseOrderID",
        "PurchaseOrderItemID"
      ],
      "fields": [
        "NetAmount"
      ],
      "object": "byd_p_receipt_line",
      "key": [
        "GoodsAndServiceAcknowledgementID",
        "ID"
      ]
    },
    {
      "name": "SupplierInvoice",
      "label": "Supplier invoices",
      "export": "Supplier invoices for those orders: ID, CreationDateTime, SellerPartyID, LifeCycleStatusCode and the tenant's own fields. Times in UTC as the OData services return them (2026-01-05T14:30:00Z).",
      "required": [
        "ID",
        "CreationDateTime"
      ],
      "fields": [
        "SellerPartyID",
        "LifeCycleStatusCode",
        "CurrencyCode",
        "TotalNetAmount"
      ],
      "date_field": "CreationDateTime",
      "object": "byd_p_invoice",
      "key": [
        "ID"
      ],
      "noun": "supplier invoices"
