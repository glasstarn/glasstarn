        "ID",
        "CreationDateTime"
      ],
      "fields": [
        "SellerPartyID",
        "LifeCycleStatusCode",
        "CurrencyCode",
        "TotalNetAmount"
      ],
      "date_field": "CreationDateTime",
      "object": "byd_p_order",
      "key": [
        "ID"
      ],
      "noun": "purchase orders"
    },
    {
      "name": "PurchaseOrderItem",
      "label": "Purchase order lines",
      "export": "The items of those orders, with the request item each came from (blank if none): PurchaseOrderID (the document), ID (the item), ProductID, Quantity, PurchaseRequestID, PurchaseRequestItemID.",
      "required": [
        "PurchaseOrderID",
        "ID",
        "ProductID",
        "Quantity",
        "PurchaseRequestID",
        "PurchaseRequestItemID"
      ],
      "fields": [
        "NetAmount"
      ],
      "object": "byd_p_order_line",
      "key": [
        "PurchaseOrderID",
        "ID"
      ],
      "noun": "purchase order lines"
    },
    {
      "name": "GoodsAndServiceAcknowledgement",
      "label": "Goods receipts",
      "export": "Goods receipts for those orders: ID, CreationDateTime, SellerPartyID, LifeCycleStatusCode and the tenant's own fields. Times in UTC as the OData services return them (2026-01-05T14:30:00Z).",
