{
  "id": "jde-purchase-to-pay",
  "version": 1,
  "name": "Purchase to pay (JD Edwards EnterpriseOne)",
  "system": "JD Edwards EnterpriseOne",
  "process": "purchase to pay",
  "status": "untested",
  "note": "Written by the Glasstarn project from public knowledge of the JD Edwards EnterpriseOne tables. Not yet confirmed on a real system; tested only on made-up tables in the standard layout. Status steps need the detail ledger (F43199, F42199), which records a row for each status change only where the company switched it on.",
  "case_object_type": "purchase order line",
  "size_check": {
    "ask": "How many purchase order lines were entered in the period for the company?",
    "unit": "purchase order line",
    "steps_per_unit": 5
  },
  "custom_prefixes": [],
  "settings": [
    {
      "id": "offset",
      "question": "What time zone are JD Edwards dates and times recorded in (the server's or the company's)? JD Edwards stores them without a time zone. Give it as an offset from UTC, for example -06:00.",
      "example": "-06:00"
    }
  ],
  "tables": [
    {
      "name": "F4301",
      "noun": "purchase orders",
      "date_label": "the order was entered",
      "label": "Purchase order headers",
      "export": "Purchase orders (order type OP) entered in the period for the company: PHDOCO, PHDCTO, PHKCOO, PHAN8, PHTRDJ and PHUSER. Dates as stored (Julian CYYDDD, for example 126014), times as stored (HHMMSS).",
      "required": [
        "PHDOCO",
        "PHDCTO",
        "PHKCOO",
        "PHAN8",
        "PHTRDJ"
      ],
      "fields": [
        "PHUSER",
        "PHMCU"
      ],
      "date_field": "PHTRDJ",
      "object": "jde_po",
      "key": [
        "PHDOCO",
        "PHDCTO",
        "PHKCOO"
      ],
      "scope_field": "PHKCOO"
    },
    {
      "name": "F4311",
      "noun": "purchase order lines",
      "label": "Purchase order lines",
      "export": "The lines of those orders: PDDOCO, PDDCTO, PDKCOO, PDLNID, PDLITM, PDUORG, PDNXTR and PDLTTR.",
      "required": [
        "PDDOCO",
        "PDDCTO",
        "PDKCOO",
        "PDLNID",
        "PDUORG",
        "PDNXTR",
        "PDLTTR"
      ],
      "fields": [
        "PDLITM",
        "PDPRRC"
      ],
      "object": "jde_po_line",
      "key": [
        "PDDOCO",
        "PDDCTO",
        "PDKCOO",
        "PDLNID"
      ]
    },
    {
      "name": "F43199",
      "label": "Purchase order detail ledger",
      "export": "Status changes of those lines (F43199): OLDOCO, OLDCTO, OLKCOO, OLLNID, OLLTTR, OLNXTR, OLUPMJ, OLTDAY and OLUSER. Dates as stored (Julian CYYDDD, for example 126014), times as stored (HHMMSS).",
      "required": [
        "OLDOCO",
        "OLDCTO",
        "OLKCOO",
        "OLLNID",
        "OLLTTR",
        "OLUPMJ",
        "OLTDAY"
      ],
      "fields": [
        "OLNXTR",
        "OLUSER"
      ],
      "date_field": "OLUPMJ",
      "optional": true
    },
    {
      "name": "F43121",
      "label": "Receipts and matches",
      "export": "Receipt and voucher match records of those lines (F43121): PRMATC (1 receipt, 2 voucher match), PRDOCO, PRDCTO, PRKCOO, PRLNID, PRDOC, PRDCT, PRKCO, PRRCDJ, PRUREC and PRUPMJ. Dates as stored (Julian CYYDDD, for example 126014), times as stored (HHMMSS).",
      "required": [
        "PRMATC",
        "PRDOCO",
        "PRDCTO",
        "PRKCOO",
        "PRLNID",
        "PRDOC",
        "PRDCT",
        "PRKCO",
        "PRRCDJ",
        "PRUPMJ"
      ],
      "fields": [
        "PRUREC",
        "PRTDAY"
      ],
      "date_field": "PRRCDJ"
    },
    {
      "name": "F0411",
      "noun": "vouchers",
      "label": "Vouchers (accounts payable)",
      "export": "Supplier vouchers for those orders, first pay item (RPSFX 001): RPDOC, RPDCT, RPKCO, RPSFX, RPPO, RPPDCT, RPPKCO, RPDIVJ, RPDGJ, RPPST and RPAG. Dates as stored (Julian CYYDDD, for example 126014), times as stored (HHMMSS).",
      "required": [
        "RPDOC",
        "RPDCT",
        "RPKCO",
        "RPSFX",
        "RPPO",
        "RPPDCT",
        "RPPKCO",
        "RPDGJ",
        "RPPST"
      ],
      "fields": [
        "RPDIVJ",
        "RPAG",
        "RPAN8"
      ],
      "date_field": "RPDGJ",
      "object": "jde_voucher",
      "key": [
        "RPDOC",
        "RPDCT",
        "RPKCO"
      ]
    },
    {
      "name": "F0414",
      "label": "Payment details",
      "export": "Payments of those vouchers (F0414): RNPYID, RNRC5, RNDOC, RNDCT, RNKCO, RNSFX and RNPAAP.",
      "required": [
        "RNPYID",
        "RNRC5",
        "RNDOC",
        "RNDCT",
        "RNKCO",
        "RNSFX"
      ],
      "fields": [
        "RNPAAP"
      ],
      "optional": true
    },
    {
      "name": "F0413",
      "label": "Payment headers",
      "export": "The payments themselves (F0413): RMPYID, RMDOCM (payment number), RMDMTJ (payment date) and RMVDGJ (void date). Dates as stored (Julian CYYDDD, for example 126014), times as stored (HHMMSS).",
      "required": [
        "RMPYID",
        "RMDOCM",
        "RMDMTJ"
      ],
      "fields": [
        "RMVDGJ",
        "RMPYIN"
      ],
      "date_field": "RMDMTJ",
      "optional": true
    }
  ],
  "unique": [
    {
      "id": "one-po",
      "table": "F4301",
      "columns": [
        "PHDOCO",
        "PHDCTO",
        "PHKCOO"
      ],
      "label": "orders listed once"
    },
    {
      "id": "one-po-line",
      "table": "F4311",
      "columns": [
        "PDDOCO",
        "PDDCTO",
        "PDKCOO",
        "PDLNID"
      ],
      "label": "order lines listed once"
    },
    {
      "id": "one-voucher",
      "table": "F0411",
      "columns": [
        "RPDOC",
        "RPDCT",
        "RPKCO"
      ],
      "label": "vouchers listed once",
      "where": [
        {
          "column": "RPSFX",
          "in": [
            "001"
          ]
        }
      ]
    },
    {
      "id": "one-payment-detail",
      "table": "F0414",
      "columns": [
        "RNPYID",
        "RNRC5"
      ],
      "label": "payment details listed once"
    },
    {
      "id": "one-payment",
      "table": "F0413",
      "columns": [
        "RMPYID"
      ],
      "label": "payments listed once"
    }
  ],
  "checks": [
    {
      "id": "lines-have-orders",
      "label": "order lines whose order is in the export",
      "from": {
        "table": "F4311",
        "columns": [
          "PDDOCO",
          "PDDCTO",
          "PDKCOO"
        ]
      },
      "to": {
        "table": "F4301",
        "columns": [
          "PHDOCO",
          "PHDCTO",
          "PHKCOO"
        ]
      },
      "expect": "all"
    },
    {
      "id": "receipts-have-lines",
      "label": "receipts and matches whose order line is in the export",
      "from": {
        "table": "F43121",
        "columns": [
          "PRDOCO",
          "PRDCTO",
          "PRKCOO",
          "PRLNID"
        ]
      },
      "to": {
        "table": "F4311",
        "columns": [
          "PDDOCO",
          "PDDCTO",
          "PDKCOO",
          "PDLNID"
        ]
      },
      "expect": "all"
    },
    {
      "id": "ledger-has-lines",
      "label": "status changes whose order line is in the export",
      "from": {
        "table": "F43199",
        "columns": [
          "OLDOCO",
          "OLDCTO",
          "OLKCOO",
          "OLLNID"
        ]
      },
      "to": {
        "table": "F4311",
        "columns": [
          "PDDOCO",
          "PDDCTO",
          "PDKCOO",
          "PDLNID"
        ]
      },
      "expect": "all"
    },
    {
      "id": "vouchers-have-orders",
      "label": "vouchers whose order is in the export",
      "from": {
        "table": "F0411",
        "columns": [
          "RPPO",
          "RPPDCT",
          "RPPKCO"
        ],
        "where": [
          {
            "column": "RPSFX",
            "in": [
              "001"
            ]
          },
          {
            "column": "RPPO",
            "not_in": [
              ""
            ]
          }
        ]
      },
      "to": {
        "table": "F4301",
        "columns": [
          "PHDOCO",
          "PHDCTO",
          "PHKCOO"
        ]
      },
      "expect": "most",
      "threshold": 0.95,
      "question": {
        "text": "{missing} of {total} vouchers are for orders entered before the period. Keep them without their order, or re-export with the older orders?",
        "options": [
          {
            "id": "keep",
            "label": "Keep them without their order"
          },
          {
            "id": "re-export",
            "label": "Re-export with the older orders"
          }
        ],
        "recommended": "keep"
      }
    },
    {
      "id": "payments-have-vouchers",
      "label": "payment details whose voucher is in the export",
      "from": {
        "table": "F0414",
        "columns": [
          "RNDOC",
          "RNDCT",
          "RNKCO"
        ]
      },
      "to": {
        "table": "F0411",
        "columns": [
          "RPDOC",
          "RPDCT",
          "RPKCO"
        ]
      },
      "expect": "all"
    },
    {
      "id": "payment-details-have-payments",
      "label": "payment details whose payment is in the export",
      "from": {
        "table": "F0414",
        "columns": [
          "RNPYID"
        ]
      },
      "to": {
        "table": "F0413",
        "columns": [
          "RMPYID"
        ]
      },
      "expect": "all"
    }
  ],
  "recipe": {
