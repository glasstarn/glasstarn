          "key": [
            "BANK_SETID",
            "BANK_CD",
            "BANK_ACCT_KEY",
            "PYMNT_ID"
          ],
          "matching": [
            "BANK_SETID",
            "BANK_CD",
            "BANK_ACCT_KEY",
            "PYMNT_ID"
          ],
          "columns": [
