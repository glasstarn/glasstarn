        ],
        "activity": {
          "value": "Receive goods"
        },
        "timestamp": {
          "date": "RECEIPT_DT",
          "offset": "{setting:offset}"
        },
        "attributes": [
          {
            "column": "QTY_SH_ACCPT",
            "name": "quantity"
          }
        ],
        "objects": [
          {
            "object": "ps_po_line",
            "columns": [
              "BUSINESS_UNIT_PO",
              "PO_ID",
              "LINE_NBR"
            ],
            "qualifier": "purchase order line"
          }
        ]
      },
      {
