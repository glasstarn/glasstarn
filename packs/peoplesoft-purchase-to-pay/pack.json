        ],
        "activity": {
          "value": "Create purchase order"
        },
        "timestamp": {
          "date": "PO_DT",
          "offset": "{setting:offset}"
        },
        "attributes": [
          {
            "column": "BUYER_ID",
            "name": "resource"
          }
        ],
        "objects": [
          {
            "object": "ps_po",
            "columns": [
              "BUSINESS_UNIT",
              "PO_ID"
            ],
            "qualifier": "purchase order"
          }
        ]
      },
      {
        "id": "ps_po_approved",
        "input": "PS_PO_HDR",
        "namespace": "peoplesoft",
        "key": [
          "BUSINESS_UNIT",
          "PO_ID"
        ],
        "activity": {
          "value": "Approve purchase order"
        },
        "timestamp": {
          "date": "APPROVAL_DT",
          "offset": "{setting:offset}"
        },
        "optional_timestamp": true,
        "objects": [
          {
            "object": "ps_po",
            "columns": [
              "BUSINESS_UNIT",
              "PO_ID"
            ],
            "qualifier": "purchase order"
          }
        ]
      },
      {
        "id": "ps_goods_received",
        "input": "PS_RECV_LN_SHIP",
        "namespace": "peoplesoft",
