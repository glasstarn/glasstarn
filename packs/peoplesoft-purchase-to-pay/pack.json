        "attributes": [
          {
            "column": "GROSS_AMT",
            "name": "amount"
          }
        ],
        "objects": [
          {
            "object": "ps_voucher",
            "columns": [
              "BUSINESS_UNIT",
              "VOUCHER_ID"
            ],
            "qualifier": "voucher"
          }
        ]
      },
      {
        "id": "ps_voucher_approved",
        "input": "PS_VOUCHER",
        "namespace": "peoplesoft",
        "key": [
          "BUSINESS_UNIT",
          "VOUCHER_ID"
        ],
        "activity": {
          "value": "Approve voucher"
        },
        "timestamp": {
          "date": "APPROVAL_DT",
          "offset": "{setting:offset}"
        },
        "optional_timestamp": true,
        "objects": [
          {
            "object": "ps_voucher",
            "columns": [
              "BUSINESS_UNIT",
              "VOUCHER_ID"
            ],
            "qualifier": "voucher"
          }
        ]
      },
      {
