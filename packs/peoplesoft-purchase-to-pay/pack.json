            "PYMNT_ID_REF"
          ]
        },
        "timestamp": {
          "date": "PYMNT_DT",
          "offset": "{setting:offset}"
        },
        "attributes": [
          {
            "column": "PYMNT_ID_REF",
            "name": "payment reference"
          }
        ],
        "objects": [
          {
            "object": "ps_voucher",
            "columns": [
              "BUSINESS_UNIT",
              "VOUCHER_ID"
            ],
            "qualifier": "voucher"
          }
        ]
      }
    ],
    "relationships": [
      {
        "id": "ps_po_has_line",
        "input": "PS_PO_LINE",
        "source": {
          "object": "ps_po",
          "columns": [
            "BUSINESS_UNIT",
            "PO_ID"
          ],
          "qualifier": "purchase order"
        },
        "target": {
          "object": "ps_po_line",
          "columns": [
            "BUSINESS_UNIT",
            "PO_ID",
            "LINE_NBR"
          ],
          "qualifier": "purchase order line"
        }
      },
      {
        "id": "ps_req_became_line",
        "input": "PS_PO_LINE_DISTRIB",
        "where": [
          {
            "column": "REQ_ID",
            "not_in": [
              ""
            ]
          },
          {
            "column": "DISTRIB_LINE_NUM",
            "in": [
              "1"
            ]
          }
        ],
        "source": {
          "object": "ps_req",
          "columns": [
            "BUSINESS_UNIT_REQ",
            "REQ_ID"
          ],
          "qualifier": "requisition"
        },
        "target": {
          "object": "ps_po_line",
          "columns": [
            "BUSINESS_UNIT",
            "PO_ID",
            "LINE_NBR"
          ],
          "qualifier": "purchase order line"
        }
      },
      {
        "id": "ps_voucher_for_line",
        "input": "PS_VOUCHER_LINE",
        "where": [
          {
            "column": "PO_ID",
            "not_in": [
              ""
            ]
          }
        ],
        "source": {
          "object": "ps_voucher",
