      ],
      "label": "ledger entries listed once"
    }
  ],
  "checks": [
    {
      "id": "lines-have-orders",
      "label": "order lines whose order is in the export",
      "from": {
        "table": "Purchase Line",
        "columns": [
          "Document No."
        ],
        "where": [
          {
            "column": "Document Type",
            "in": [
              "Order"
            ]
          }
        ]
      },
      "to": {
        "table": "Purchase Header",
        "columns": [
          "No."
        ],
        "where": [
          {
            "column": "Document Type",
            "in": [
              "Order"
            ]
          }
        ]
      },
      "expect": "all"
    },
    {
      "id": "approvals-have-orders",
      "label": "approval entries whose order is in the export",
      "from": {
        "table": "Approval Entry",
        "columns": [
          "Document No."
        ],
        "where": [
          {
            "column": "Table ID",
            "in": [
              "38"
            ]
          },
          {
            "column": "Document Type",
            "in": [
              "Order"
            ]
          }
        ]
      },
      "to": {
        "table": "Purchase Header",
        "columns": [
          "No."
        ],
        "where": [
          {
            "column": "Document Type",
            "in": [
              "Order"
            ]
          }
        ]
      },
      "expect": "most",
      "threshold": 1.0,
      "question": {
        "text": "{missing} of {total} approval entries belong to orders that are not in the export ({missing_share}), usually fully invoiced orders deleted because order archiving is off. Keep the approvals on the order known from its receipts and invoices, or re-export with the order archive?",
        "options": [
          {
            "id": "keep",
            "label": "Keep them on the order"
          },
          {
            "id": "re-export",
            "label": "Re-export with the order archive"
          }
        ],
        "recommended": "keep"
      }
    },
    {
      "id": "posted-lines-have-order-lines",
      "label": "posted lines whose order line is in the export",
      "from": {
        "table": "Purch. Rcpt. Line",
        "columns": [
          "Order No.",
          "Order Line No."
        ],
        "where": [
          {
            "column": "Order No.",
            "not_in": [
              ""
            ]
          }
        ]
      },
      "to": {
        "table": "Purchase Line",
        "columns": [
          "Document No.",
          "Line No."
        ],
        "where": [
          {
            "column": "Document Type",
            "in": [
              "Order"
            ]
          }
        ]
      },
      "expect": "most",
      "threshold": 1.0,
      "question": {
        "text": "{missing} of {total} receipt lines belong to orders that are not in the export ({missing_share}), usually fully invoiced orders, which Business Central deletes unless order archiving is on. Follow them from their receipts and invoices, without the order's own creation and approval steps, or re-export with the order archive?",
        "options": [
          {
            "id": "keep",
            "label": "Follow them from their receipts and invoices"
          },
          {
            "id": "re-export",
            "label": "Re-export with the order archive"
          }
        ],
        "recommended": "keep"
      }
    },
    {
      "id": "invoice-lines-have-invoices",
      "label": "invoice lines whose invoice is in the export",
      "from": {
        "table": "Purch. Inv. Line",
        "columns": [
          "Document No."
        ]
      },
      "to": {
        "table": "Purch. Inv. Header",
        "columns": [
          "No."
        ]
      },
      "expect": "all"
    },
    {
      "id": "invoice-lines-have-order-lines",
      "label": "invoice lines whose order line is in the export",
      "from": {
        "table": "Purch. Inv. Line",
        "columns": [
          "Order No.",
          "Order Line No."
        ],
        "where": [
          {
            "column": "Order No.",
            "not_in": [
              ""
            ]
          }
        ]
      },
      "to": {
        "table": "Purchase Line",
        "columns": [
          "Document No.",
          "Line No."
        ],
        "where": [
          {
            "column": "Document Type",
            "in": [
              "Order"
            ]
          }
        ]
      },
      "expect": "most",
      "threshold": 0.95,
      "question": {
        "text": "{missing} of {total} invoice lines bill orders that are not in the export: orders created before the period, or fully invoiced orders deleted because order archiving is off. Follow them from their invoices without the order, or re-export with the older orders and the order archive?",
        "options": [
          {
            "id": "keep",
            "label": "Keep them without their order"
          },
          {
            "id": "re-export",
            "label": "Re-export with the older orders"
          }
        ],
        "recommended": "keep"
      }
    }
  ],
