{
  "id": "servicenow-incident-management",
  "version": 1,
  "name": "Incident management (ServiceNow)",
  "system": "ServiceNow",
  "process": "incident management",
  "status": "tested",
  "note": "Written by the Glasstarn project from public knowledge of ServiceNow's Table API, its standard tables and the audit history (sys_audit). Checked on a real ServiceNow instance on 2026-10-15 with planted records; see the README. Steps come from audited fields; a field excluded from auditing leaves no steps.",
  "case_object_type": "incident",
  "size_check": {
    "ask": "How many incidents were opened in the period?",
    "unit": "incident",
    "steps_per_unit": 7
  },
  "custom_prefixes": [
    "u_"
  ],
  "tables": [
    {
      "name": "ServiceNowIncident",
      "noun": "incidents",
      "date_label": "the incident was opened",
      "label": "ServiceNow incidents",
      "export": "Incidents with activity in the period, from the ServiceNow extract (table incident): sys_id, number, created, state, priority, category, assignment_group, assigned_to and the company's own fields (u_…), with state, priority and assignment group labels.",
      "required": [
        "sys_id",
        "number",
        "created",
        "state",
        "priority",
        "state_label",
        "priority_label"
      ],
      "fields": [
        "category",
        "assignment_group",
        "assigned_to",
        "assignment_group_label"
      ],
      "date_field": "created",
      "object": "sn_incident",
      "key": [
        "sys_id"
      ]
    },
    {
      "name": "ServiceNowAudit",
      "label": "ServiceNow audit history",
      "export": "The audit history (sys_audit) of those records, one row per changed field, from the ServiceNow extract: table, record, audit_id, created, user, field, old and new stored values and their display labels.",
      "required": [
        "table",
        "record",
        "audit_id",
        "created",
        "field",
        "old_value",
        "old_label",
        "new_value",
        "new_label"
      ],
      "fields": [
        "user"
      ],
      "date_field": "created"
    }
  ],
  "unique": [
    {
      "id": "one-ServiceNowIncident",
      "table": "ServiceNowIncident",
      "columns": [
        "sys_id"
      ],
      "label": "incidents listed once"
    },
    {
      "id": "one-audit-row",
      "table": "ServiceNowAudit",
      "columns": [
        "audit_id"
      ],
      "label": "audit rows listed once"
    }
  ],
  "checks": [
    {
      "id": "audit-has-incident",
      "label": "audit rows whose incident is in the extract",
      "from": {
        "table": "ServiceNowAudit",
        "columns": [
          "record"
        ],
        "where": [
          {
            "column": "table",
            "in": [
              "incident"
            ]
          }
        ]
      },
      "to": {
        "table": "ServiceNowIncident",
        "columns": [
          "sys_id"
        ]
      },
      "expect": "all"
    }
  ],
  "recipe": {
    "version": 1,
    "format": "ocel",
    "objects": [
      {
        "id": "sn_incident",
        "input": "ServiceNowIncident",
        "namespace": "servicenow",
        "object_type": "incident",
        "key": [
          "sys_id"
        ],
        "attributes": [
          {
            "column": "number",
            "name": "number"
          },
          {
            "column": "priority_label",
            "name": "priority"
          },
          {
            "column": "category",
            "name": "category"
          },
          {
            "column": "state_label",
            "name": "state"
          }
        ]
      }
    ],
    "events": [
      {
        "id": "incident_opened",
        "input": "ServiceNowIncident",
        "namespace": "servicenow",
        "key": [
          "sys_id"
        ],
        "activity": {
          "value": "Open incident"
        },
        "timestamp": "created",
        "objects": [
          {
            "object": "sn_incident",
            "columns": [
              "sys_id"
            ],
            "qualifier": "incident"
          }
        ]
      },
      {
        "id": "state_changed",
        "input": "ServiceNowAudit",
        "namespace": "servicenow",
        "key": [
          "audit_id"
        ],
        "where": [
          {
            "column": "table",
            "in": [
              "incident"
            ]
          },
          {
            "column": "field",
            "in": [
              "state"
            ]
          }
        ],
        "timestamp": "created",
        "attributes": [
          {
            "column": "user",
            "name": "resource"
          },
          {
            "column": "old_label",
            "name": "from"
          },
          {
            "column": "new_label",
            "name": "to"
          }
        ],
        "objects": [
          {
            "object": "sn_incident",
            "columns": [
              "record"
            ],
            "qualifier": "incident"
          }
        ],
        "activity": {
          "column": "new_label"
        }
      },
      {
        "id": "group_assigned",
        "input": "ServiceNowAudit",
        "namespace": "servicenow",
        "key": [
          "audit_id"
        ],
        "where": [
          {
            "column": "table",
            "in": [
              "incident"
            ]
          },
          {
            "column": "field",
            "in": [
              "assignment_group"
            ]
          },
          {
            "column": "old_value",
            "in": [
              ""
            ]
          }
        ],
        "timestamp": "created",
        "attributes": [
          {
            "column": "user",
            "name": "resource"
          },
          {
            "column": "old_label",
            "name": "from"
          },
          {
            "column": "new_label",
            "name": "to"
          }
        ],
        "objects": [
          {
            "object": "sn_incident",
            "columns": [
              "record"
            ],
            "qualifier": "incident"
          }
        ],
        "activity": {
          "value": "Assign to group"
        }
      },
      {
        "id": "group_reassigned",
        "input": "ServiceNowAudit",
        "namespace": "servicenow",
        "key": [
          "audit_id"
        ],
        "where": [
          {
            "column": "table",
            "in": [
              "incident"
            ]
          },
          {
            "column": "field",
            "in": [
              "assignment_group"
            ]
          },
          {
            "column": "old_value",
            "not_in": [
              ""
            ]
          }
        ],
        "timestamp": "created",
        "attributes": [
          {
            "column": "user",
            "name": "resource"
          },
          {
            "column": "old_label",
            "name": "from"
          },
          {
            "column": "new_label",
            "name": "to"
          }
        ],
        "objects": [
          {
            "object": "sn_incident",
            "columns": [
              "record"
            ],
            "qualifier": "incident"
          }
        ],
        "activity": {
          "value": "Reassign to another group"
        }
      },
      {
        "id": "person_assigned",
        "input": "ServiceNowAudit",
        "namespace": "servicenow",
        "key": [
          "audit_id"
        ],
        "where": [
          {
            "column": "table",
            "in": [
              "incident"
            ]
          },
          {
            "column": "field",
            "in": [
              "assigned_to"
            ]
          },
          {
            "column": "old_value",
            "in": [
              ""
            ]
          }
        ],
        "timestamp": "created",
        "attributes": [
          {
            "column": "user",
            "name": "resource"
          },
          {
            "column": "old_label",
            "name": "from"
          },
          {
            "column": "new_label",
            "name": "to"
          }
        ],
        "objects": [
          {
            "object": "sn_incident",
            "columns": [
              "record"
            ],
            "qualifier": "incident"
          }
        ],
        "activity": {
          "value": "Assign to person"
        }
      },
      {
        "id": "person_reassigned",
        "input": "ServiceNowAudit",
        "namespace": "servicenow",
        "key": [
          "audit_id"
        ],
        "where": [
          {
            "column": "table",
            "in": [
              "incident"
            ]
          },
          {
            "column": "field",
            "in": [
              "assigned_to"
            ]
          },
          {
            "column": "old_value",
            "not_in": [
              ""
            ]
          }
        ],
        "timestamp": "created",
        "attributes": [
          {
            "column": "user",
            "name": "resource"
          },
          {
            "column": "old_label",
            "name": "from"
          },
          {
            "column": "new_label",
            "name": "to"
          }
        ],
        "objects": [
          {
            "object": "sn_incident",
            "columns": [
              "record"
            ],
            "qualifier": "incident"
          }
        ],
        "activity": {
          "value": "Reassign to another person"
        }
      },
      {
        "id": "priority_changed",
        "input": "ServiceNowAudit",
        "namespace": "servicenow",
        "key": [
          "audit_id"
        ],
        "where": [
          {
            "column": "table",
            "in": [
              "incident"
            ]
          },
          {
            "column": "field",
            "in": [
              "priority"
            ]
          }
        ],
        "timestamp": "created",
        "attributes": [
          {
            "column": "user",
            "name": "resource"
          },
          {
            "column": "old_label",
            "name": "from"
          },
          {
            "column": "new_label",
            "name": "to"
          }
        ],
        "objects": [
          {
            "object": "sn_incident",
            "columns": [
              "record"
            ],
            "qualifier": "incident"
          }
        ],
        "activity": {
          "value": "Change priority"
        }
      },
      {
        "id": "field_changed",
        "input": "ServiceNowAudit",
        "namespace": "servicenow",
        "key": [
          "audit_id"
        ],
        "where": [
          {
            "column": "table",
            "in": [
              "incident"
            ]
          },
          {
            "column": "field",
            "not_in": [
              "state",
