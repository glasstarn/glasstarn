          }
        ],
        "timestamp": "created",
        "attributes": [
          {
            "column": "user",
            "name": "resource"
          },
          {
            "column": "old_label",
            "name": "from"
          },
          {
            "column": "new_label",
            "name": "to"
          }
        ],
        "objects": [
          {
            "object": "sn_incident",
            "columns": [
              "record"
            ],
            "qualifier": "incident"
          }
        ],
        "activity": {
          "column": "field",
          "prefix": "Change "
        }
      }
    ]
  }
}
