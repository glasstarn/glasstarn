{
  "id": "servicenow-problem-management",
  "version": 1,
  "name": "Problem management (ServiceNow)",
  "system": "ServiceNow",
  "process": "problem management",
  "status": "tested",
  "note": "Written by the Glasstarn project from public knowledge of ServiceNow's Table API, its standard tables and the audit history (sys_audit). Checked on a real ServiceNow instance on 2026-10-15 with planted records; see the README. Steps come from audited fields; a field excluded from auditing leaves no steps.",
  "case_object_type": "problem",
  "size_check": {
    "ask": "How many problems were opened in the period?",
    "unit": "problem",
    "steps_per_unit": 7
  },
  "custom_prefixes": [
    "u_"
  ],
  "tables": [
    {
      "name": "ServiceNowProblem",
      "noun": "problems",
      "date_label": "the problem was opened",
      "label": "ServiceNow problems",
      "export": "Problems with activity in the period, from the ServiceNow extract (table problem): sys_id, number, created, state, priority, assignment_group, assigned_to and the company's own fields (u_…), with state, priority and assignment group labels.",
      "required": [
        "sys_id",
        "number",
        "created",
        "state",
        "state_label"
      ],
      "fields": [
        "priority",
        "priority_label",
        "assignment_group",
        "assigned_to",
        "assignment_group_label"
      ],
      "date_field": "created",
      "object": "sn_problem",
      "key": [
        "sys_id"
      ]
    },
    {
      "name": "ServiceNowProblemTask",
      "noun": "problem tasks",
      "date_label": "the task was created",
      "label": "ServiceNow problem tasks",
      "export": "The problem tasks of those problems (table problem_task, by problem): sys_id, number, created, problem, state, assignment_group, with state and assignment group labels. Optional.",
      "optional": true,
      "required": [
        "sys_id",
        "number",
        "created",
        "problem",
        "state",
        "state_label"
      ],
      "fields": [
        "assignment_group",
        "assignment_group_label"
      ],
      "date_field": "created",
      "object": "sn_problem_task",
      "key": [
        "sys_id"
      ]
    },
    {
      "name": "ServiceNowAudit",
      "label": "ServiceNow audit history",
      "export": "The audit history (sys_audit) of those records, one row per changed field, from the ServiceNow extract: table, record, audit_id, created, user, field, old and new stored values and their display labels.",
      "required": [
        "table",
        "record",
        "audit_id",
        "created",
        "field",
        "old_value",
        "old_label",
        "new_value",
        "new_label"
      ],
      "fields": [
        "user"
      ],
      "date_field": "created"
    }
  ],
  "unique": [
    {
      "id": "one-ServiceNowProblem",
      "table": "ServiceNowProblem",
      "columns": [
        "sys_id"
      ],
      "label": "problems listed once"
    },
    {
      "id": "one-ServiceNowProblemTask",
      "table": "ServiceNowProblemTask",
      "columns": [
        "sys_id"
      ],
      "label": "problem tasks listed once"
    },
    {
      "id": "one-audit-row",
      "table": "ServiceNowAudit",
      "columns": [
        "audit_id"
      ],
      "label": "audit rows listed once"
    }
  ],
  "checks": [
    {
      "id": "audit-has-problem",
      "label": "audit rows whose problem is in the extract",
      "from": {
        "table": "ServiceNowAudit",
        "columns": [
          "record"
        ],
        "where": [
          {
            "column": "table",
            "in": [
              "problem"
            ]
          }
        ]
      },
      "to": {
        "table": "ServiceNowProblem",
        "columns": [
          "sys_id"
        ]
      },
      "expect": "all"
    },
    {
      "id": "audit-has-task",
      "label": "audit rows whose task is in the extract",
      "from": {
        "table": "ServiceNowAudit",
        "columns": [
          "record"
        ],
        "where": [
          {
            "column": "table",
            "in": [
              "problem_task"
            ]
          }
        ]
      },
      "to": {
        "table": "ServiceNowProblemTask",
        "columns": [
          "sys_id"
        ]
      },
      "expect": "all"
    },
    {
      "id": "tasks-have-problem",
      "label": "tasks whose problem is in the extract",
      "from": {
        "table": "ServiceNowProblemTask",
        "columns": [
          "problem"
        ]
      },
      "to": {
        "table": "ServiceNowProblem",
        "columns": [
          "sys_id"
        ]
      },
      "expect": "all"
    }
  ],
