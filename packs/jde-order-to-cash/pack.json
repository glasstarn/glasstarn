      "columns": [
        "RPDOC",
        "RPDCT",
        "RPKCO"
      ],
      "label": "invoices listed once",
      "where": [
        {
          "column": "RPSFX",
          "in": [
            "001"
          ]
        }
      ]
    },
    {
      "id": "one-receipt-detail",
      "table": "F03B14",
      "columns": [
        "RZPYID",
        "RZRC5"
      ],
      "label": "receipt details listed once"
    },
    {
      "id": "one-receipt",
      "table": "F03B13",
      "columns": [
        "RYPYID"
      ],
      "label": "receipts listed once"
    }
  ],
  "checks": [
    {
      "id": "lines-have-orders",
      "label": "order lines whose order is in the export",
      "from": {
        "table": "F4211",
        "columns": [
          "SDDOCO",
          "SDDCTO",
          "SDKCOO"
        ]
      },
      "to": {
        "table": "F4201",
        "columns": [
          "SHDOCO",
          "SHDCTO",
          "SHKCOO"
        ]
      },
      "expect": "all"
    },
    {
      "id": "ledger-has-lines",
      "label": "status changes whose order line is in the export",
      "from": {
        "table": "F42199",
        "columns": [
          "SLDOCO",
          "SLDCTO",
          "SLKCOO",
          "SLLNID"
        ]
      },
      "to": {
        "table": "F4211",
        "columns": [
          "SDDOCO",
          "SDDCTO",
          "SDKCOO",
          "SDLNID"
        ]
      },
      "expect": "all"
    },
    {
      "id": "invoiced-lines-have-invoices",
      "label": "invoiced lines whose invoice is in the export",
      "from": {
        "table": "F4211",
        "columns": [
          "SDDOC",
          "SDDCT",
          "SDKCO"
        ],
        "where": [
          {
            "column": "SDDOC",
            "not_in": [
              "",
              "0"
            ]
          }
        ]
      },
      "to": {
        "table": "F03B11",
        "columns": [
          "RPDOC",
          "RPDCT",
          "RPKCO"
        ]
      },
      "expect": "all"
    },
    {
      "id": "receipts-have-invoices",
      "label": "receipt details whose invoice is in the export",
      "from": {
        "table": "F03B14",
        "columns": [
          "RZDOC",
          "RZDCT",
          "RZKCO"
        ]
      },
      "to": {
        "table": "F03B11",
        "columns": [
          "RPDOC",
          "RPDCT",
          "RPKCO"
        ]
      },
      "expect": "all"
    },
    {
      "id": "receipt-details-have-receipts",
      "label": "receipt details whose receipt is in the export",
      "from": {
        "table": "F03B14",
        "columns": [
          "RZPYID"
        ]
      },
      "to": {
        "table": "F03B13",
        "columns": [
          "RYPYID"
        ]
      },
      "expect": "all"
    }
  ],
