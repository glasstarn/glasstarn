{
  "id": "jde-order-to-cash",
  "version": 1,
  "name": "Order to cash (JD Edwards EnterpriseOne)",
  "system": "JD Edwards EnterpriseOne",
  "process": "order to cash",
  "status": "untested",
  "note": "Written by the Glasstarn project from public knowledge of the JD Edwards EnterpriseOne tables. Not yet confirmed on a real system; tested only on made-up tables in the standard layout. Status steps need the detail ledger (F43199, F42199), which records a row for each status change only where the company switched it on.",
  "case_object_type": "sales order line",
  "size_check": {
    "ask": "How many sales order lines were entered in the period for the company?",
    "unit": "sales order line",
    "steps_per_unit": 5
  },
  "custom_prefixes": [],
  "settings": [
    {
      "id": "offset",
      "question": "What time zone are JD Edwards dates and times recorded in (the server's or the company's)? JD Edwards stores them without a time zone. Give it as an offset from UTC, for example -06:00.",
      "example": "-06:00"
    }
  ],
  "tables": [
    {
      "name": "F4201",
      "noun": "sales orders",
      "date_label": "the order was entered",
      "label": "Sales order headers",
      "export": "Sales orders (order type SO) entered in the period for the company: SHDOCO, SHDCTO, SHKCOO, SHAN8, SHTRDJ and SHUSER. Dates as stored (Julian CYYDDD, for example 126014), times as stored (HHMMSS).",
      "required": [
        "SHDOCO",
        "SHDCTO",
        "SHKCOO",
        "SHAN8",
        "SHTRDJ"
      ],
      "fields": [
        "SHUSER",
        "SHMCU"
      ],
      "date_field": "SHTRDJ",
      "object": "jde_so",
      "key": [
        "SHDOCO",
        "SHDCTO",
        "SHKCOO"
      ],
      "scope_field": "SHKCOO"
    },
    {
      "name": "F4211",
      "noun": "sales order lines",
      "label": "Sales order lines",
      "export": "The lines of those orders, open (F4211) and closed (F42119) in one file: SDDOCO, SDDCTO, SDKCOO, SDLNID, SDLITM, SDUORG, SDNXTR, SDLTTR, SDADDJ (actual ship date), SDDOC, SDDCT and SDKCO (the invoice). Dates as stored (Julian CYYDDD, for example 126014), times as stored (HHMMSS).",
      "required": [
        "SDDOCO",
        "SDDCTO",
        "SDKCOO",
        "SDLNID",
        "SDUORG",
        "SDNXTR",
        "SDLTTR",
        "SDADDJ",
        "SDDOC",
        "SDDCT",
        "SDKCO"
      ],
      "fields": [
        "SDLITM",
        "SDUPRC"
      ],
      "object": "jde_so_line",
      "key": [
        "SDDOCO",
        "SDDCTO",
        "SDKCOO",
        "SDLNID"
      ]
    },
    {
      "name": "F42199",
      "label": "Sales order detail ledger",
      "export": "Status changes of those lines (F42199): SLDOCO, SLDCTO, SLKCOO, SLLNID, SLLTTR, SLNXTR, SLUPMJ, SLTDAY and SLUSER. Dates as stored (Julian CYYDDD, for example 126014), times as stored (HHMMSS).",
      "required": [
        "SLDOCO",
        "SLDCTO",
        "SLKCOO",
        "SLLNID",
        "SLLTTR",
        "SLUPMJ",
        "SLTDAY"
      ],
      "fields": [
        "SLNXTR",
        "SLUSER"
      ],
      "date_field": "SLUPMJ",
      "optional": true
    },
    {
      "name": "F03B11",
      "noun": "customer invoices",
      "label": "Customer invoices",
      "export": "Invoices for those orders, first pay item (RPSFX 001): RPDOC, RPDCT, RPKCO, RPSFX, RPDIVJ, RPAN8, RPAG and RPPST. Dates as stored (Julian CYYDDD, for example 126014), times as stored (HHMMSS).",
      "required": [
        "RPDOC",
        "RPDCT",
        "RPKCO",
        "RPSFX",
        "RPDIVJ",
        "RPPST"
      ],
      "fields": [
        "RPAN8",
        "RPAG"
      ],
      "date_field": "RPDIVJ",
      "object": "jde_invoice",
      "key": [
        "RPDOC",
        "RPDCT",
        "RPKCO"
      ]
    },
    {
      "name": "F03B14",
      "label": "Receipt details",
      "export": "Customer payments applied to those invoices (F03B14): RZPYID, RZRC5, RZDOC, RZDCT, RZKCO, RZSFX and RZPAAP.",
      "required": [
        "RZPYID",
        "RZRC5",
        "RZDOC",
        "RZDCT",
        "RZKCO",
        "RZSFX"
      ],
      "fields": [
        "RZPAAP"
      ],
      "optional": true
    },
    {
      "name": "F03B13",
      "label": "Receipt headers",
      "export": "The receipts themselves (F03B13): RYPYID, RYCKNU (receipt number) and RYDMTJ (receipt date). Dates as stored (Julian CYYDDD, for example 126014), times as stored (HHMMSS).",
      "required": [
        "RYPYID",
        "RYCKNU",
        "RYDMTJ"
      ],
      "fields": [
        "RYVDGJ"
      ],
      "date_field": "RYDMTJ",
      "optional": true
    }
  ],
  "unique": [
    {
      "id": "one-so",
      "table": "F4201",
      "columns": [
        "SHDOCO",
        "SHDCTO",
        "SHKCOO"
