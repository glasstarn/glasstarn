            "name": "notification type"
          },
          {
            "column": "PRIOK",
            "name": "priority"
          }
        ]
      },
      {
        "id": "equipment",
        "input": "EQUI",
        "namespace": "sap",
        "object_type": "equipment",
        "key": [
          "EQUNR"
        ],
        "attributes": [
          {
            "column": "EQTYP",
            "name": "equipment category"
          },
          {
            "column": "TYPBZ",
            "name": "model"
          }
        ]
      },
      {
        "id": "maintenance_order",
        "input": "AFIH",
        "namespace": "sap",
        "object_type": "maintenance order",
