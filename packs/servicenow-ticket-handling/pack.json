{
  "id": "servicenow-ticket-handling",
  "version": 1,
  "name": "Ticket handling (ServiceNow, any task-based table)",
  "system": "ServiceNow",
  "process": "ticket handling",
  "status": "tested",
  "note": "Written by the Glasstarn project from public knowledge of ServiceNow's Table API, its standard tables and the audit history (sys_audit). Checked on a real ServiceNow instance on 2026-10-15 with planted records; see the README. Steps come from audited fields; a field excluded from auditing leaves no steps. Works on any ServiceNow table built on task: HR cases, customer service cases, facilities, security incidents or a company's own ticket table, named in the settings.",
  "case_object_type": "ticket",
  "size_check": {
    "ask": "How many tickets were opened in the period?",
    "unit": "ticket",
    "steps_per_unit": 7
  },
  "custom_prefixes": [
    "u_"
  ],
  "settings": [
    {
      "id": "ticket_table",
      "question": "Which ServiceNow table holds the tickets? For example sn_hr_core_case (HR cases), sn_customerservice_case (customer service cases), sn_sec_inc (security incidents) or the company's own table (u_…).",
      "example": "sn_hr_core_case"
    },
    {
      "id": "task_table",
      "question": "Which table holds the tickets' tasks, such as sn_hr_core_task? Answer none when the tickets have no tasks.",
      "example": "sn_hr_core_task"
    }
  ],
  "tables": [
    {
      "name": "ServiceNowTicket",
      "noun": "tickets",
      "date_label": "the ticket was opened",
      "label": "ServiceNow tickets",
      "export": "Tickets with activity in the period, from the ServiceNow extract of the ticket table read \"as\": \"ticket\": sys_id, number, created, state, priority, assignment_group, assigned_to and the company's own fields (u_…), with state, priority and assignment group labels.",
      "required": [
        "sys_id",
        "number",
        "created",
        "state",
        "state_label"
      ],
      "fields": [
        "priority",
        "priority_label",
        "assignment_group",
        "assigned_to",
        "assignment_group_label"
      ],
      "date_field": "created",
      "object": "sn_ticket",
      "key": [
        "sys_id"
      ]
    },
    {
      "name": "ServiceNowTicketTask",
      "noun": "tasks",
      "date_label": "the task was created",
      "label": "ServiceNow ticket tasks",
      "export": "The tasks of those tickets, from the task table read \"as\": \"ticket_task\" with its parent field: sys_id, number, created, ticket, state, assignment_group, with state and assignment group labels. Optional.",
      "optional": true,
      "required": [
        "sys_id",
        "number",
        "created",
        "ticket",
        "state",
        "state_label"
      ],
      "fields": [
        "assignment_group",
        "assignment_group_label"
      ],
      "date_field": "created",
      "object": "sn_ticket_task",
      "key": [
        "sys_id"
      ]
    },
    {
      "name": "ServiceNowAudit",
      "label": "ServiceNow audit history",
      "export": "The audit history (sys_audit) of those records, one row per changed field, from the ServiceNow extract: table, record, audit_id, created, user, field, old and new stored values and their display labels.",
      "required": [
        "table",
        "record",
        "audit_id",
        "created",
        "field",
        "old_value",
        "old_label",
        "new_value",
        "new_label"
      ],
      "fields": [
        "user"
      ],
      "date_field": "created"
    }
  ],
  "unique": [
    {
      "id": "one-ServiceNowTicket",
      "table": "ServiceNowTicket",
      "columns": [
        "sys_id"
      ],
      "label": "tickets listed once"
    },
    {
      "id": "one-ServiceNowTicketTask",
      "table": "ServiceNowTicketTask",
      "columns": [
        "sys_id"
      ],
      "label": "tasks listed once"
    },
    {
      "id": "one-audit-row",
      "table": "ServiceNowAudit",
      "columns": [
        "audit_id"
      ],
      "label": "audit rows listed once"
    }
  ],
  "checks": [
    {
      "id": "audit-has-ticket",
      "label": "audit rows whose ticket is in the extract",
      "from": {
        "table": "ServiceNowAudit",
        "columns": [
          "record"
        ],
        "where": [
          {
            "column": "table",
            "in": [
              "{setting:ticket_table}"
            ]
          }
        ]
      },
      "to": {
        "table": "ServiceNowTicket",
        "columns": [
          "sys_id"
        ]
      },
      "expect": "all"
    },
    {
      "id": "audit-has-task",
      "label": "audit rows whose task is in the extract",
      "from": {
        "table": "ServiceNowAudit",
        "columns": [
          "record"
        ],
        "where": [
          {
            "column": "table",
            "in": [
              "{setting:task_table}"
            ]
          }
        ]
      },
      "to": {
        "table": "ServiceNowTicketTask",
        "columns": [
          "sys_id"
        ]
      },
      "expect": "all"
    },
    {
      "id": "tasks-have-ticket",
      "label": "tasks whose ticket is in the extract",
      "from": {
        "table": "ServiceNowTicketTask",
        "columns": [
          "ticket"
        ]
      },
      "to": {
        "table": "ServiceNowTicket",
        "columns": [
          "sys_id"
        ]
      },
      "expect": "all"
    }
  ],
