{
  "id": "sap-business-one-order-to-cash",
  "version": 1,
  "name": "Order to cash (SAP Business One)",
  "system": "SAP Business One",
  "process": "order to cash",
  "status": "untested",
  "note": "Written by the Glasstarn project from public knowledge of the SAP Business One database tables. Not yet confirmed on a real company database; tested only on made-up tables in the standard layout. Approval steps need the approval procedures' tables (OWDD, WDD1); approval times are read as HHMMSS.",
  "case_object_type": "sales order line",
  "size_check": {
    "ask": "How many sales order lines were created in the period?",
    "unit": "sales order line",
    "steps_per_unit": 4
  },
  "custom_prefixes": [
    "U_*"
  ],
  "settings": [
    {
      "id": "offset",
      "question": "What time zone is the SAP Business One server set to? Business One stores creation times without a time zone. Give it as an offset from UTC, for example +01:00.",
      "example": "+01:00"
    }
  ],
  "tables": [
    {
      "name": "OQUT",
      "label": "Sales quotations",
      "export": "Sales quotations created in the period (OQUT). Header fields DocEntry, DocNum, CardCode, DocDate, CreateDate, CreateTS, DocTotal, CANCELED and UserSign. Include cancellation documents (CANCELED = C) and their lines. Dates as YYYY-MM-DD; CreateTS as the stored number (HHMMSS). Leave BaseEntry and BaseLine blank on lines without a base document.",
      "required": [
        "DocEntry",
        "DocNum",
        "CardCode",
        "DocDate",
        "CreateDate",
        "CreateTS",
        "CANCELED"
      ],
      "fields": [
        "DocTotal",
        "UserSign",
        "DocStatus",
        "DocDueDate",
        "draftKey",
        "CancelDate"
      ],
      "date_field": "CreateDate",
      "object": "b1_s_request",
      "key": [
        "DocEntry"
      ],
      "optional": true
    },
    {
      "name": "QUT1",
      "label": "Sales quotation lines",
      "export": "The lines of those sales quotations (QUT1). Fields DocEntry, LineNum, ItemCode, Quantity, Price, BaseType, BaseEntry and BaseLine.",
      "required": [
        "DocEntry",
        "LineNum",
        "ItemCode",
        "Quantity",
        "BaseType",
        "BaseEntry",
        "BaseLine"
      ],
      "fields": [
        "Price",
        "LineTotal",
        "LineStatus"
      ],
      "optional": true
    },
    {
      "name": "ORDR",
      "label": "Sales orders",
      "export": "Sales orders created in the period (ORDR). Header fields DocEntry, DocNum, CardCode, DocDate, CreateDate, CreateTS, DocTotal, CANCELED and UserSign. Include cancellation documents (CANCELED = C) and their lines. Dates as YYYY-MM-DD; CreateTS as the stored number (HHMMSS). Leave BaseEntry and BaseLine blank on lines without a base document.",
      "required": [
        "DocEntry",
        "DocNum",
        "CardCode",
        "DocDate",
        "CreateDate",
        "CreateTS",
        "CANCELED"
      ],
      "fields": [
        "DocTotal",
        "UserSign",
        "DocStatus",
        "DocDueDate",
        "draftKey",
        "CancelDate"
      ],
      "date_field": "CreateDate",
      "noun": "sales orders",
      "date_label": "the order was created",
      "object": "b1_s_order",
      "key": [
        "DocEntry"
      ]
    },
    {
      "name": "RDR1",
      "label": "Sales order lines",
      "export": "The lines of those orders (RDR1). Fields DocEntry, LineNum, ItemCode, Quantity, Price, BaseType, BaseEntry and BaseLine.",
      "required": [
        "DocEntry",
        "LineNum",
        "ItemCode",
        "Quantity",
        "BaseType",
        "BaseEntry",
        "BaseLine"
      ],
      "fields": [
        "Price",
        "LineTotal",
        "LineStatus"
      ],
      "noun": "sales order lines",
      "object": "b1_s_order_line",
      "key": [
        "DocEntry",
        "LineNum"
      ]
    },
    {
      "name": "ODLN",
      "label": "Deliverys",
      "export": "Deliverys based on those orders (ODLN). Header fields DocEntry, DocNum, CardCode, DocDate, CreateDate, CreateTS, DocTotal, CANCELED and UserSign. Include cancellation documents (CANCELED = C) and their lines. Dates as YYYY-MM-DD; CreateTS as the stored number (HHMMSS). Leave BaseEntry and BaseLine blank on lines without a base document.",
      "required": [
        "DocEntry",
        "DocNum",
        "CardCode",
        "DocDate",
        "CreateDate",
        "CreateTS",
        "CANCELED"
      ],
      "fields": [
        "DocTotal",
        "UserSign",
        "DocStatus",
        "DocDueDate",
        "draftKey",
        "CancelDate"
      ],
      "date_field": "CreateDate"
    },
    {
      "name": "DLN1",
      "label": "Delivery lines",
      "export": "The lines of those documents (DLN1). Fields DocEntry, LineNum, ItemCode, Quantity, Price, BaseType, BaseEntry and BaseLine.",
      "required": [
        "DocEntry",
        "LineNum",
        "ItemCode",
        "Quantity",
        "BaseType",
        "BaseEntry",
        "BaseLine"
      ],
      "fields": [
        "Price",
        "LineTotal",
        "LineStatus"
      ],
      "object": "b1_s_receipt_line",
      "key": [
        "DocEntry",
        "LineNum"
      ]
    },
    {
      "name": "OINV",
      "label": "Customer invoices",
      "export": "Customer invoices for those orders or documents (OINV). Header fields DocEntry, DocNum, CardCode, DocDate, CreateDate, CreateTS, DocTotal, CANCELED and UserSign. Include cancellation documents (CANCELED = C) and their lines. Dates as YYYY-MM-DD; CreateTS as the stored number (HHMMSS). Leave BaseEntry and BaseLine blank on lines without a base document.",
      "required": [
        "DocEntry",
        "DocNum",
        "CardCode",
        "DocDate",
        "CreateDate",
        "CreateTS",
        "CANCELED"
      ],
      "fields": [
        "DocTotal",
        "UserSign",
        "DocStatus",
        "DocDueDate",
        "draftKey",
        "CancelDate"
      ],
      "date_field": "CreateDate",
      "noun": "customer invoices",
      "object": "b1_s_invoice",
      "key": [
        "DocEntry"
      ]
    },
    {
      "name": "INV1",
      "label": "Customer invoice lines",
      "export": "The lines of those invoices (INV1). Fields DocEntry, LineNum, ItemCode, Quantity, Price, BaseType, BaseEntry and BaseLine.",
      "required": [
        "DocEntry",
        "LineNum",
        "ItemCode",
        "Quantity",
        "BaseType",
        "BaseEntry",
        "BaseLine"
      ],
      "fields": [
        "Price",
        "LineTotal",
        "LineStatus"
      ]
    },
    {
      "name": "ORCT",
      "label": "Payments",
      "export": "Payments that pay those invoices (ORCT): DocEntry, DocNum, CardCode, DocDate, CreateDate, CreateTS, Canceled and DocTotal. Include cancellation documents (CANCELED = C) and their lines. Dates as YYYY-MM-DD; CreateTS as the stored number (HHMMSS). Leave BaseEntry and BaseLine blank on lines without a base document.",
      "required": [
        "DocEntry",
        "DocNum",
        "CardCode",
        "DocDate",
        "CreateDate",
        "CreateTS",
        "Canceled"
      ],
      "fields": [
        "DocTotal",
        "UserSign"
      ],
      "date_field": "CreateDate",
      "optional": true
    },
    {
      "name": "RCT2",
      "label": "Paid invoices",
      "export": "The invoices each of those payments pays (RCT2): DocNum (the payment's DocEntry), InvoiceId, DocEntry (the invoice), InvType and SumApplied.",
      "required": [
        "DocNum",
        "InvoiceId",
        "DocEntry",
        "InvType"
      ],
      "fields": [
        "SumApplied"
      ],
      "optional": true
    },
    {
      "name": "OWDD",
      "label": "Approval requests",
      "export": "Approval requests for sales orders (OWDD, ObjType 17): WddCode, ObjType, DocEntry (the draft), Status, CreateDate and CreateTime (as HHMMSS).",
      "required": [
        "WddCode",
        "ObjType",
        "DocEntry",
        "Status",
        "CreateDate",
        "CreateTime"
      ],
      "fields": [
        "OwnerID"
      ],
      "date_field": "CreateDate",
      "optional": true
    },
    {
      "name": "WDD1",
      "label": "Approval decisions",
      "export": "The decisions on those requests (WDD1): WddCode, StepCode, UserID, Status (Y approved, N rejected), UpdateDate and UpdateTime (as HHMMSS).",
      "required": [
        "WddCode",
        "StepCode",
        "UserID",
        "Status",
        "UpdateDate",
        "UpdateTime"
      ],
      "fields": [],
      "date_field": "UpdateDate",
      "optional": true
    },
    {
      "name": "OCRD",
      "noun": "customers",
      "label": "Customers",
      "export": "The customers on those documents (OCRD): CardCode, CardType, GroupCode, Country and the company's own fields. No names or contact details.",
      "required": [
        "CardCode",
        "CardType"
      ],
      "fields": [
        "GroupCode",
        "Country"
      ],
      "object": "b1_s_partner",
      "key": [
        "CardCode"
      ],
      "optional": true
    }
  ],
  "unique": [
