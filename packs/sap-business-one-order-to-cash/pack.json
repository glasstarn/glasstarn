  "checks": [
    {
      "id": "request-lines-have-requests",
      "label": "request lines whose document is in the export",
      "from": {
        "table": "QUT1",
        "columns": [
          "DocEntry"
        ]
      },
      "to": {
        "table": "OQUT",
        "columns": [
          "DocEntry"
        ]
      },
      "expect": "all"
    },
    {
      "id": "order-lines-have-orders",
      "label": "order lines whose order is in the export",
      "from": {
        "table": "RDR1",
        "columns": [
          "DocEntry"
        ]
      },
      "to": {
        "table": "ORDR",
        "columns": [
          "DocEntry"
        ]
      },
      "expect": "all"
    },
    {
      "id": "receipt-lines-have-documents",
      "label": "lines whose document is in the export",
      "from": {
        "table": "DLN1",
        "columns": [
          "DocEntry"
        ]
      },
      "to": {
        "table": "ODLN",
        "columns": [
          "DocEntry"
        ]
      },
      "expect": "all"
    },
    {
      "id": "invoice-lines-have-invoices",
      "label": "invoice lines whose invoice is in the export",
      "from": {
        "table": "INV1",
        "columns": [
          "DocEntry"
        ]
      },
      "to": {
        "table": "OINV",
        "columns": [
          "DocEntry"
        ]
      },
      "expect": "all"
    },
    {
      "id": "receipt-lines-have-order-lines",
      "label": "lines based on an order line in the export",
      "from": {
        "table": "DLN1",
        "columns": [
          "BaseEntry",
          "BaseLine"
        ],
        "where": [
          {
            "column": "BaseType",
            "in": [
              "17"
            ]
          }
        ]
      },
      "to": {
        "table": "RDR1",
        "columns": [
          "DocEntry",
          "LineNum"
        ]
      },
      "expect": "most",
      "threshold": 0.95,
      "question": {
        "text": "{missing} of {total} lines are based on orders created before the period. Keep them without their order, or re-export with the older orders?",
        "options": [
          {
            "id": "keep",
            "label": "Keep them without their order"
          },
          {
            "id": "re-export",
            "label": "Re-export with the older orders"
          }
        ],
        "recommended": "keep"
      }
    },
    {
      "id": "decisions-have-requests",
      "label": "approval decisions whose request is in the export",
      "from": {
        "table": "WDD1",
        "columns": [
          "WddCode"
        ]
      },
      "to": {
        "table": "OWDD",
        "columns": [
          "WddCode"
        ]
      },
      "expect": "all"
    },
    {
      "id": "paid-invoices-have-payments",
      "label": "paid invoices whose payment is in the export",
      "from": {
        "table": "RCT2",
        "columns": [
          "DocNum"
        ]
      },
      "to": {
        "table": "ORCT",
        "columns": [
          "DocEntry"
        ]
      },
      "expect": "all"
    },
    {
      "id": "paid-invoices-are-exported",
      "label": "paid invoices that are in the export",
      "from": {
        "table": "RCT2",
        "columns": [
          "DocEntry"
        ],
        "where": [
          {
            "column": "InvType",
            "in": [
              "13"
            ]
          }
        ]
      },
      "to": {
        "table": "OINV",
        "columns": [
          "DocEntry"
        ]
      },
      "expect": "all"
    }
  ],
  "recipe": {
    "version": 1,
    "format": "ocel",
    "objects": [
      {
        "id": "b1_s_request",
        "input": "OQUT",
