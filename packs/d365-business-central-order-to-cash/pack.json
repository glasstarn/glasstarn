{
  "id": "d365-business-central-order-to-cash",
  "version": 2,
  "name": "Order to cash (Dynamics 365 Business Central)",
  "system": "Microsoft Dynamics 365 Business Central",
  "process": "order to cash",
  "status": "tested",
  "note": "Tested by the Glasstarn project on a Business Central online CRONUS demo company (2026-10-16), from the standard configuration-package export, with order archiving off and on: check and build passed and every step count matched the source tables; not certified or endorsed by Microsoft. Without the order archive, fully invoiced orders are followed from their shipments and invoices without their creation and approval steps. SystemCreatedAt is left out by that export, so order and posting dates are used, to the day. Approvals were not exercised (the demo has none).",
  "case_object_type": "sales order line",
  "size_check": {
    "ask": "How many sales order lines were created in the period?",
    "unit": "sales order line",
    "steps_per_unit": 5
  },
  "custom_prefixes": [],
  "settings": [
    {
      "id": "offset",
      "question": "Date-only fields (such as the date an invoice was closed by payment) are in the company's time zone. Which offset from UTC is that, for example +01:00?",
      "example": "+01:00"
    }
  ],
  "tables": [
    {
      "name": "Sales Header",
      "noun": "sales orders",
      "date_label": "the order was created",
      "label": "Sales orders",
      "export": "Orders (Document Type Order) created in the period, open ones from Sales Header and invoiced ones from Sales Header Archive (latest version), in one file (other document types, such as quotes and invoices, may stay in the file; only orders are read): No., Document Type, Sell-to Customer No., Order Date, Status and SystemCreatedAt. SystemCreatedAt and date-times in UTC as stored (2026-01-05T14:30:00Z); dates as YYYY-MM-DD.",
      "required": [
        "No.",
        "Document Type",
        "Sell-to Customer No.",
        "SystemCreatedAt"
      ],
      "fields": [
        "Order Date",
        "Status",
        "Amount"
      ],
      "date_field": "SystemCreatedAt",
      "object": "bc_s_order",
      "key": [
        "No."
      ],
      "fallbacks": [
        {
          "field": "SystemCreatedAt",
          "column": "Order Date",
          "date_only": true
        }
      ],
      "archive": {
        "table": "Sales Header Archive",
        "key": [
          "Document Type",
          "No."
        ],
        "version": "Version No."
      }
    },
    {
      "name": "Sales Line",
      "noun": "sales order lines",
      "label": "Sales order lines",
      "export": "The lines of those orders, from Sales Line and Sales Line Archive (latest version) in one file: Document Type, Document No., Line No., Type, No. (item), Quantity and SystemCreatedAt.",
      "required": [
        "Document Type",
        "Document No.",
        "Line No.",
        "No.",
        "Quantity"
      ],
      "fields": [
        "Type",
        "Line Amount",
        "SystemCreatedAt"
      ],
      "object": "bc_s_line",
      "key": [
        "Document No.",
        "Line No."
      ],
      "archive": {
        "table": "Sales Line Archive",
        "key": [
          "Document Type",
          "Document No.",
          "Line No."
        ],
        "version": "Version No."
      }
    },
    {
      "name": "Approval Entry",
      "label": "Approval entries",
      "export": "Approval entries of those orders (Table ID 36): Entry No., Table ID, Document Type, Document No., Sequence No., Approver ID, Status, Date-Time Sent for Approval and Last Date-Time Modified.",
      "required": [
        "Entry No.",
        "Table ID",
        "Document Type",
        "Document No.",
        "Status",
        "Date-Time Sent for Approval",
        "Last Date-Time Modified"
      ],
      "fields": [
        "Sequence No.",
        "Approver ID"
      ],
      "date_field": "Date-Time Sent for Approval",
      "optional": true
    },
    {
      "name": "Sales Shipment Line",
      "label": "Shipment lines",
      "export": "Posted shipment lines of those orders: Document No., Line No., Order No., Order Line No., Quantity, Posting Date and SystemCreatedAt.",
      "required": [
        "Document No.",
        "Line No.",
        "Order No.",
        "Order Line No.",
        "SystemCreatedAt"
      ],
      "fields": [
        "Quantity",
        "Posting Date"
      ],
      "date_field": "SystemCreatedAt",
      "fallbacks": [
        {
          "field": "SystemCreatedAt",
          "column": "Posting Date",
          "date_only": true
        }
      ]
    },
    {
      "name": "Sales Invoice Header",
      "noun": "posted sales invoices",
      "label": "Posted sales invoices",
      "export": "Posted invoices for those orders: No., Order No., Posting Date, Amount and SystemCreatedAt. SystemCreatedAt and date-times in UTC as stored (2026-01-05T14:30:00Z); dates as YYYY-MM-DD.",
      "required": [
        "No.",
        "Order No.",
        "SystemCreatedAt"
      ],
      "fields": [
        "Posting Date",
        "Amount",
        "External Document No."
      ],
      "date_field": "SystemCreatedAt",
      "object": "bc_s_invoice",
      "key": [
        "No."
      ],
      "fallbacks": [
        {
          "field": "SystemCreatedAt",
          "column": "Posting Date",
          "date_only": true
        }
      ]
    },
    {
      "name": "Sales Invoice Line",
      "label": "Posted sales invoice lines",
      "export": "Their lines: Document No., Line No., Order No., Order Line No. and Quantity.",
      "required": [
        "Document No.",
        "Line No.",
        "Order No.",
        "Order Line No."
      ],
      "fields": [
        "Quantity",
        "Amount"
      ]
    },
    {
      "name": "Cust. Ledger Entry",
      "label": "Ledger entries",
      "export": "The customer ledger entries of those invoices (Document Type Invoice): Entry No., Document Type, Document No., Open and Closed at Date.",
      "required": [
        "Entry No.",
        "Document Type",
        "Document No.",
        "Open",
        "Closed at Date"
      ],
      "fields": [
        "Amount",
        "Due Date"
      ],
      "optional": true
    }
  ],
