        "namespace": "servicenow",
        "object_type": "catalog task",
        "key": [
          "sys_id"
        ],
        "attributes": [
          {
            "column": "number",
            "name": "number"
          },
          {
            "column": "state_label",
            "name": "state"
          }
        ]
      }
    ],
    "relationships": [
