{
  "id": "sap-ecc-billing",
  "note": "Customer invoices and their cancellations from SAP ECC or S/4HANA tables.",
  "tables": [
    {
      "name": "VBRK",
      "noun": "invoices",
      "date_label": "the invoice was created",
      "label": "Billing documents (customer invoices)",
      "export": "Financial billing documents of the company code, with VBTYP M/N/O/P/S/5/6, including both cancellation categories and the originals they reference. Export billing requests, invoice lists and pro formas separately.",
      "required": [
        "VBELN",
        "FKART",
        "ERDAT",
        "ERZET",
        "BUKRS",
        "KUNAG",
        "NETWR",
        "FKSTO",
        "SFAKN",
        "VBTYP"
      ],
      "fields": [
        "FKDAT",
        "WAERK"
      ],
      "date_field": "ERDAT",
      "object": "billing",
      "key": [
        "VBELN"
      ],
      "scope_field": "BUKRS"
    },
    {
      "name": "VBRP",
      "label": "Billing document items",
      "export": "Items of the exported billing documents.",
      "required": [
        "VBELN",
        "POSNR",
        "AUBEL",
        "AUPOS"
      ],
      "fields": [
        "VGBEL",
        "VGPOS",
        "FKIMG",
        "NETWR"
      ]
    }
  ],
  "unique": [
    {
      "id": "one-billing-document",
      "table": "VBRK",
      "columns": [
        "VBELN"
      ],
      "label": "billing documents listed once"
    },
    {
      "id": "one-billing-item",
      "table": "VBRP",
      "columns": [
        "VBELN",
        "POSNR"
      ],
      "label": "billing items listed once (document and item)"
    }
  ],
  "checks": [
    {
      "id": "invoices-have-customers",
      "label": "invoices whose customer is in the customer list",
      "from": {
        "table": "VBRK",
        "columns": [
          "KUNAG"
        ]
      },
      "to": {
        "table": "KNA1",
        "columns": [
          "KUNNR"
        ]
      },
      "expect": "all"
    },
    {
      "id": "billing-items-have-documents",
      "label": "billing items whose billing document is in the export",
      "from": {
        "table": "VBRP",
        "columns": [
          "VBELN"
        ]
      },
      "to": {
        "table": "VBRK",
        "columns": [
          "VBELN"
        ]
      },
      "expect": "all"
    },
    {
      "id": "vbrk-document-scope",
      "scope": true,
      "label": "billing headers must be financial invoice/debit/credit documents or their cancellations (VBTYP M/N/O/P/S/5/6); export requests, lists and pro formas separately",
      "from": {
        "table": "VBRK",
        "columns": [
          "VBTYP"
        ]
      },
      "to": {
        "table": "VBRK",
        "columns": [
          "VBTYP"
        ],
        "where": [
          {
            "column": "VBTYP",
            "in": [
              "M",
              "N",
              "O",
              "P",
              "S",
              "5",
              "6"
            ]
          }
        ]
      },
      "expect": "all",
      "require_nonblank": true
    }
  ],
