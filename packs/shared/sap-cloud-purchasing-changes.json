        "ChangeDocObjectClass",
        "ChangeDocObject",
        "ChangeDocument",
        "CreatedByUser",
        "CreationDate",
        "CreationTime"
      ],
      "fields": [
        "ChangeTransactionCode"
      ],
      "date_field": "CreationDate",
      "optional": true
    },
    {
      "name": "ChangeDocumentItem",
      "label": "Change log items",
      "export": "The changed fields of those change documents, at least for tables EKKO, EKPO, EKET and BSEG.",
      "required": [
        "ChangeDocObjectClass",
        "ChangeDocObject",
        "ChangeDocument",
        "DatabaseTable",
        "ChangeDocTableKey",
        "ChangeDocDatabaseTableField",
        "ChangeDocNewFieldValue",
        "ChangeDocPreviousFieldValue"
      ],
      "fields": [
        "ChangeDocItemChangeType"
      ],
      "optional": true
    }
  ],
