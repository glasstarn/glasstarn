{
  "id": "sap-cloud-sales",
  "note": "Sales orders and deliveries from SAP S/4HANA Public Cloud data views.",
  "custom_prefixes": [
    "YY1_"
  ],
  "tables": [
    {
      "name": "SalesOrder",
      "noun": "sales orders",
      "date_label": "the order was created",
      "label": "Sales orders",
      "export": "Sales orders of the company code created in the period, including the company's own fields (names starting with YY1_).",
      "required": [
        "SalesOrder",
        "SoldToParty",
        "CreationDate",
        "CreationTime",
        "CompanyCode",
        "SalesOrderType"
      ],
      "fields": [
        "SalesOrderType",
        "SalesOrganization",
        "CreatedByUser",
        "TotalNetAmount",
        "TransactionCurrency"
      ],
      "date_field": "CreationDate",
      "object": "sales_order",
      "key": [
        "SalesOrder"
      ],
      "scope_field": "CompanyCode",
      "fan_out": [
        {
          "input": "SalesOrderItem",
          "event_key": [
            "SalesOrder"
          ],
          "target": {
            "object": "sales_item",
            "columns": [
              "SalesOrder",
              "SalesOrderItem"
            ],
            "qualifier": "order line"
          }
        }
      ]
    },
    {
      "name": "SalesOrderItem",
      "noun": "sales order items",
      "label": "Sales order items",
      "export": "All items of the exported sales orders.",
      "required": [
        "SalesOrder",
        "SalesOrderItem",
        "Material",
        "NetAmount",
        "SalesDocumentRjcnReason",
        "ReferenceSDDocument",
        "ReferenceSDDocumentItem"
      ],
      "fields": [
        "SalesOrderItemText",
        "RequestedQuantity",
        "Plant"
      ],
      "object": "sales_item",
      "key": [
        "SalesOrder",
        "SalesOrderItem"
      ]
    },
    {
      "name": "OutboundDelivery",
      "noun": "deliveries",
      "date_label": "the delivery was created",
      "label": "Outbound deliveries",
      "export": "Deliveries for the exported sales orders, up to the export date.",
      "required": [
        "OutboundDelivery",
        "DeliveryDocumentType",
        "CreationDate",
        "CreationTime",
        "ActualGoodsMovementDate",
        "SoldToParty"
      ],
      "fields": [
        "PlannedGoodsIssueDate",
        "ShippingPoint"
      ],
      "date_field": "CreationDate",
      "object": "delivery",
      "key": [
        "OutboundDelivery"
      ]
    },
    {
      "name": "OutboundDeliveryItem",
      "label": "Outbound delivery items",
      "export": "Items of the exported deliveries.",
      "required": [
        "OutboundDelivery",
        "OutboundDeliveryItem",
        "ReferenceSDDocument",
        "ReferenceSDDocumentItem"
      ],
      "fields": [
        "Material",
        "ActualDeliveryQuantity"
      ]
    }
  ],
  "unique": [
    {
      "id": "one-sales-order",
      "table": "SalesOrder",
      "columns": [
        "SalesOrder"
      ],
      "label": "sales orders listed once"
    },
    {
      "id": "one-sales-item",
      "table": "SalesOrderItem",
      "columns": [
        "SalesOrder",
        "SalesOrderItem"
      ],
      "label": "sales order items listed once"
    },
    {
      "id": "one-delivery",
      "table": "OutboundDelivery",
      "columns": [
        "OutboundDelivery"
      ],
      "label": "deliveries listed once"
    },
    {
      "id": "one-delivery-item",
      "table": "OutboundDeliveryItem",
      "columns": [
        "OutboundDelivery",
        "OutboundDeliveryItem"
      ],
      "label": "delivery items listed once"
    }
  ],
  "checks": [
    {
      "id": "items-have-orders",
      "label": "order items whose sales order is in the export",
      "from": {
        "table": "SalesOrderItem",
        "columns": [
          "SalesOrder"
        ]
      },
      "to": {
        "table": "SalesOrder",
        "columns": [
          "SalesOrder"
        ]
      },
      "expect": "all"
    },
    {
      "id": "orders-have-customers",
      "label": "sales orders whose customer is in the customer list",
      "from": {
        "table": "SalesOrder",
        "columns": [
          "SoldToParty"
        ]
      },
      "to": {
        "table": "Customer",
        "columns": [
          "Customer"
        ]
      },
      "expect": "all"
    },
    {
      "id": "delivery-items-have-deliveries",
      "label": "delivery items whose delivery is in the export",
      "from": {
        "table": "OutboundDeliveryItem",
        "columns": [
          "OutboundDelivery"
        ]
      },
      "to": {
        "table": "OutboundDelivery",
        "columns": [
          "OutboundDelivery"
        ]
      },
      "expect": "all"
    },
    {
      "id": "deliveries-reach-orders",
      "label": "delivery items whose order item is in the export",
      "from": {
        "table": "OutboundDeliveryItem",
        "columns": [
          "ReferenceSDDocument",
          "ReferenceSDDocumentItem"
        ]
      },
      "to": {
        "table": "SalesOrderItem",
        "columns": [
          "SalesOrder",
          "SalesOrderItem"
        ]
      },
      "expect": "most",
      "threshold": 0.95,
      "question": {
        "text": "{missing} of {total} delivery items ({missing_share}) refer to sales orders that are not in the export, usually orders created before the period. They will show without the order's earlier steps. Should the SAP admin export older orders too?",
        "options": [
          {
            "id": "widen",
            "label": "Yes, export orders from earlier months as well"
          },
          {
            "id": "keep",
            "label": "No, analyse them without those orders"
          }
        ],
        "recommended": "widen"
      }
    }
  ],
