        "event": "ariba_invoice_exception_resolved",
        "through": "ariba_invoice",
        "relationship": "ariba_invoice_sap",
        "qualifier": "supplier invoice"
      },
      {
        "id": "ariba_invoice_exception_resolved_lines",
        "event": "ariba_invoice_exception_resolved",
        "through": "invoice",
        "relationship": "invoice_order_lines",
        "qualifier": "order line"
      },
      {
        "id": "ariba_invoice_approved_order",
