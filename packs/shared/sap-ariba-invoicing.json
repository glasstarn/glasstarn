        "through": "ariba_invoice",
        "relationship": "ariba_invoice_sap",
        "qualifier": "supplier invoice"
      },
      {
        "id": "ariba_invoice_approved_lines",
        "event": "ariba_invoice_approved",
        "through": "invoice",
