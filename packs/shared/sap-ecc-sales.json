{
  "id": "sap-ecc-sales",
  "note": "Sales orders and deliveries from SAP ECC or S/4HANA tables.",
  "custom_prefixes": [
    "ZZ",
    "YY"
  ],
  "tables": [
    {
      "name": "VBAK",
      "noun": "sales orders",
      "date_label": "the order was created",
      "label": "Sales orders",
      "export": "Sales orders of the company code created in the period (filter BUKRS_VF and ERDAT), including the company's own fields. Select VBTYP C/I/H/K/L; quotation, inquiry, proposal, contract and scheduling-agreement histories are separate scopes.",
      "required": [
        "VBELN",
        "KUNNR",
        "ERDAT",
        "ERZET",
        "BUKRS_VF",
        "AUART",
        "VBTYP"
      ],
      "fields": [
        "VKORG",
        "VTWEG",
        "SPART",
        "ERNAM",
        "NETWR",
        "WAERK",
        "CMGST"
      ],
      "date_field": "ERDAT",
      "object": "sales_order",
      "key": [
        "VBELN"
      ],
      "scope_field": "BUKRS_VF",
      "fan_out": [
        {
          "input": "VBAP",
          "event_key": [
            "VBELN"
          ],
          "target": {
            "object": "sales_item",
            "columns": [
              "VBELN",
              "POSNR"
            ],
            "qualifier": "order line"
          }
        }
      ]
    },
    {
      "name": "VBAP",
      "noun": "sales order items",
      "label": "Sales order items",
      "export": "All items of the exported sales orders.",
      "required": [
        "VBELN",
        "POSNR",
        "MATNR",
        "NETWR",
        "ABGRU",
        "VGBEL",
        "VGPOS"
      ],
      "fields": [
        "ARKTX",
        "KWMENG",
        "VRKME",
        "WERKS",
        "ERDAT"
      ],
      "object": "sales_item",
      "key": [
        "VBELN",
        "POSNR"
      ]
    },
    {
      "name": "LIKP",
      "noun": "deliveries",
      "date_label": "the delivery was created",
      "label": "Outbound deliveries",
      "export": "Deliveries for the exported sales orders, up to the export date. Select VBTYP J/T (outbound/return deliveries).",
      "required": [
        "VBELN",
        "LFART",
        "ERDAT",
        "ERZET",
        "WADAT_IST",
        "KUNNR",
        "VBTYP"
      ],
      "fields": [
        "LFDAT",
        "VSTEL"
      ],
      "date_field": "ERDAT",
      "object": "delivery",
      "key": [
        "VBELN"
      ]
    },
    {
      "name": "LIPS",
      "label": "Outbound delivery items",
      "export": "Items of the exported deliveries.",
      "required": [
        "VBELN",
        "POSNR",
        "VGBEL",
        "VGPOS"
      ],
      "fields": [
        "MATNR",
        "LFIMG"
      ]
    }
  ],
  "unique": [
    {
      "id": "one-sales-order",
      "table": "VBAK",
      "columns": [
        "VBELN"
      ],
      "label": "sales orders listed once"
    },
    {
      "id": "one-sales-item",
      "table": "VBAP",
      "columns": [
        "VBELN",
        "POSNR"
      ],
      "label": "sales order items listed once"
    },
    {
      "id": "one-delivery",
      "table": "LIKP",
      "columns": [
        "VBELN"
      ],
      "label": "deliveries listed once"
    },
    {
      "id": "one-delivery-item",
      "table": "LIPS",
      "columns": [
        "VBELN",
        "POSNR"
      ],
      "label": "delivery items listed once"
    },
    {
      "id": "one-delivery-item",
      "table": "LIPS",
      "columns": [
        "VBELN",
        "POSNR"
      ],
      "label": "delivery items listed once (document and item)"
    }
  ],
  "checks": [
    {
      "id": "items-have-orders",
      "label": "order items whose sales order is in the export",
      "from": {
        "table": "VBAP",
        "columns": [
          "VBELN"
        ]
      },
      "to": {
        "table": "VBAK",
        "columns": [
          "VBELN"
        ]
      },
      "expect": "all"
    },
    {
      "id": "orders-have-customers",
      "label": "sales orders whose customer is in the customer list",
      "from": {
        "table": "VBAK",
        "columns": [
          "KUNNR"
        ]
      },
      "to": {
        "table": "KNA1",
        "columns": [
          "KUNNR"
        ]
      },
      "expect": "all"
    },
    {
      "id": "delivery-items-have-deliveries",
      "label": "delivery items whose delivery is in the export",
      "from": {
        "table": "LIPS",
        "columns": [
          "VBELN"
        ]
      },
      "to": {
        "table": "LIKP",
        "columns": [
          "VBELN"
        ]
      },
      "expect": "all"
    },
    {
      "id": "deliveries-reach-orders",
      "label": "delivery items whose order item is in the export",
      "from": {
        "table": "LIPS",
        "columns": [
          "VGBEL",
          "VGPOS"
        ]
      },
      "to": {
        "table": "VBAP",
        "columns": [
          "VBELN",
          "POSNR"
        ]
      },
      "expect": "most",
      "threshold": 0.95,
      "question": {
        "text": "{missing} of {total} delivery items ({missing_share}) refer to sales orders that are not in the export, usually orders created before the period. They will show without the order's earlier steps. Should the SAP admin export older orders too?",
        "options": [
          {
            "id": "widen",
            "label": "Yes, export orders from earlier months as well"
          },
          {
            "id": "keep",
            "label": "No, analyse them without those orders"
          }
        ],
        "recommended": "widen"
      }
    },
    {
      "id": "vbak-document-scope",
      "scope": true,
      "label": "sales headers must be orders/free-of-charge orders, returns or credit/debit requests (VBTYP C/I/H/K/L); export quotations and other categories separately",
      "from": {
        "table": "VBAK",
        "columns": [
          "VBTYP"
        ]
      },
      "to": {
        "table": "VBAK",
        "columns": [
          "VBTYP"
        ],
        "where": [
          {
            "column": "VBTYP",
            "in": [
              "C",
              "I",
              "H",
              "K",
              "L"
            ]
          }
        ]
      },
      "expect": "all",
      "require_nonblank": true
    },
    {
      "id": "likp-document-scope",
      "scope": true,
      "label": "deliveries must be outbound or return deliveries (VBTYP J/T)",
      "from": {
        "table": "LIKP",
        "columns": [
          "VBTYP"
        ]
      },
      "to": {
        "table": "LIKP",
        "columns": [
          "VBTYP"
        ],
        "where": [
          {
            "column": "VBTYP",
            "in": [
              "J",
              "T"
            ]
          }
        ]
      },
      "expect": "all",
      "require_nonblank": true
    }
  ],
