            "column": "VALUE_NEW",
            "not_in": [
              ""
            ]
          }
        ]
      },
      "to": {
        "table": "T16FB",
        "columns": [
          "FRGKE"
        ]
      },
      "expect": "all",
      "require_nonblank": true
    }
  ],
