{
  "id": "sap-ecc-purchasing-changes",
  "note": "Order releases, line changes and invoice payment blocks from the change log of SAP ECC or S/4HANA (CDHDR and CDPOS). Needs the purchasing and payables parts.",
  "tables": [
    {
      "name": "CDHDR",
      "label": "Change log headers",
      "export": "Change headers for object classes EINKBELEG (purchase orders) and BELEG (accounting documents) of the exported documents, from the period to the export date.",
      "required": [
        "OBJECTCLAS",
        "OBJECTID",
        "CHANGENR",
        "USERNAME",
        "UDATE",
        "UTIME"
      ],
      "fields": [
        "TCODE"
      ],
      "date_field": "UDATE",
      "optional": true
    },
    {
      "name": "CDPOS",
      "label": "Change log items",
      "export": "The changed fields of those change headers (CDPOS), at least for tables EKKO, EKPO, EKET and BSEG.",
      "required": [
        "OBJECTCLAS",
        "OBJECTID",
        "CHANGENR",
        "TABNAME",
        "TABKEY",
        "FNAME",
        "VALUE_NEW",
        "VALUE_OLD"
      ],
      "fields": [
        "CHNGIND"
      ],
      "optional": true
    },
    {
      "name": "T16FB",
      "label": "Purchase-order release indicator configuration",
      "export": "Release indicators of the source SAP client: FRGKE and KZFRE (released for transmission). Include this configuration table to identify final release changes; without it no final-release event is claimed.",
      "required": [
        "FRGKE",
        "KZFRE"
      ],
      "fields": [],
      "optional": true
    }
  ],
  "unique": [
    {
      "id": "one-change-header",
      "table": "CDHDR",
      "columns": [
        "OBJECTCLAS",
        "OBJECTID",
        "CHANGENR"
      ],
      "label": "change headers listed once"
    },
    {
      "id": "one-release-indicator",
      "table": "T16FB",
      "columns": [
        "FRGKE"
      ],
      "label": "release indicator configuration listed once"
    }
  ],
  "checks": [
    {
      "id": "change-items-have-headers",
      "label": "changed fields whose change header is in the export",
      "from": {
        "table": "CDPOS",
        "columns": [
          "OBJECTCLAS",
          "OBJECTID",
          "CHANGENR"
        ]
      },
      "to": {
        "table": "CDHDR",
