{
  "id": "sap-ecc-sales-changes",
  "note": "Credit, delivery and billing blocks, rejected lines and changes from the change log of SAP ECC or S/4HANA (CDHDR and CDPOS). Needs the sales part.",
  "tables": [
    {
      "name": "CDHDR",
      "label": "Change log headers",
      "export": "Change headers for object class VERKBELEG (sales documents) of the exported orders, from the period to the export date.",
      "required": [
        "OBJECTCLAS",
        "OBJECTID",
        "CHANGENR",
        "USERNAME",
        "UDATE",
        "UTIME"
      ],
      "fields": [],
      "date_field": "UDATE",
      "optional": true
    },
    {
      "name": "CDPOS",
      "label": "Change log items",
      "export": "The changed fields of those change headers, at least for tables VBAK, VBUK and VBAP.",
      "required": [
        "OBJECTCLAS",
        "OBJECTID",
        "CHANGENR",
        "TABNAME",
        "TABKEY",
        "FNAME",
        "VALUE_NEW",
        "VALUE_OLD"
      ],
      "fields": [],
      "optional": true
    }
  ],
  "unique": [
    {
      "id": "one-change-header",
      "table": "CDHDR",
      "columns": [
        "OBJECTCLAS",
        "OBJECTID",
        "CHANGENR"
      ],
      "label": "change headers listed once"
    }
  ],
  "checks": [
    {
      "id": "change-items-have-headers",
      "label": "changed fields whose change header is in the export",
      "from": {
        "table": "CDPOS",
        "columns": [
          "OBJECTCLAS",
          "OBJECTID",
          "CHANGENR"
        ]
      },
      "to": {
        "table": "CDHDR",
        "columns": [
          "OBJECTCLAS",
          "OBJECTID",
          "CHANGENR"
        ]
      },
      "expect": "all"
    },
    {
      "id": "rejection-history-items-present",
      "label": "historical rejected items still present in the item export",
      "from": {
        "table": "CDPOS",
        "columns": [
          {
            "column": "TABKEY",
            "start": 3,
            "length": 10
          },
          {
            "column": "TABKEY",
            "start": 13,
            "length": 6
          }
        ],
        "where": [
          {
            "column": "OBJECTCLAS",
            "in": [
              "VERKBELEG"
            ]
          },
          {
            "column": "TABNAME",
            "in": [
              "VBAP"
            ]
          },
          {
            "column": "FNAME",
            "in": [
              "ABGRU"
            ]
          },
          {
            "column": "VALUE_NEW",
            "not_in": [
              ""
            ]
          }
        ]
      },
      "to": {
        "table": "VBAP",
        "columns": [
          "VBELN",
          "POSNR"
        ]
      },
      "expect": "most",
      "threshold": 1.0,
      "require_nonblank": true,
      "question": {
        "text": "{missing} of {total} historical rejection changes name items absent from the current item export. They remain on their order header with the original item key, but cannot appear on a missing item timeline. Export historical/archive items too, or keep the order-level evidence?",
        "options": [
          {
            "id": "widen",
            "label": "Export historical or archived items as well"
          },
          {
            "id": "keep",
            "label": "Keep the order-level history and disclose the missing item links"
          }
        ],
        "recommended": "widen"
      }
    }
  ],
