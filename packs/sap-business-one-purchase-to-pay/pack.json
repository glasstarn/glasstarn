  "checks": [
    {
      "id": "request-lines-have-requests",
      "label": "request lines whose document is in the export",
      "from": {
        "table": "PRQ1",
        "columns": [
          "DocEntry"
        ]
      },
      "to": {
        "table": "OPRQ",
        "columns": [
          "DocEntry"
        ]
      },
      "expect": "all"
    },
    {
      "id": "order-lines-have-orders",
      "label": "order lines whose order is in the export",
      "from": {
        "table": "POR1",
        "columns": [
          "DocEntry"
        ]
      },
      "to": {
        "table": "OPOR",
        "columns": [
          "DocEntry"
        ]
      },
      "expect": "all"
    },
    {
      "id": "receipt-lines-have-documents",
      "label": "lines whose document is in the export",
      "from": {
        "table": "PDN1",
        "columns": [
          "DocEntry"
        ]
      },
      "to": {
        "table": "OPDN",
        "columns": [
          "DocEntry"
        ]
      },
      "expect": "all"
    },
    {
      "id": "invoice-lines-have-invoices",
      "label": "invoice lines whose invoice is in the export",
      "from": {
        "table": "PCH1",
        "columns": [
          "DocEntry"
        ]
      },
      "to": {
        "table": "OPCH",
        "columns": [
          "DocEntry"
        ]
      },
      "expect": "all"
    },
    {
      "id": "receipt-lines-have-order-lines",
      "label": "lines based on an order line in the export",
      "from": {
        "table": "PDN1",
        "columns": [
          "BaseEntry",
          "BaseLine"
        ],
        "where": [
          {
            "column": "BaseType",
            "in": [
              "22"
            ]
          }
        ]
      },
      "to": {
        "table": "POR1",
        "columns": [
          "DocEntry",
          "LineNum"
        ]
      },
      "expect": "most",
      "threshold": 0.95,
      "question": {
        "text": "{missing} of {total} lines are based on orders created before the period. Keep them without their order, or re-export with the older orders?",
        "options": [
          {
            "id": "keep",
            "label": "Keep them without their order"
          },
          {
            "id": "re-export",
            "label": "Re-export with the older orders"
          }
        ],
        "recommended": "keep"
      }
    },
    {
      "id": "decisions-have-requests",
      "label": "approval decisions whose request is in the export",
      "from": {
        "table": "WDD1",
        "columns": [
          "WddCode"
        ]
      },
      "to": {
        "table": "OWDD",
        "columns": [
          "WddCode"
        ]
      },
      "expect": "all"
    },
    {
      "id": "paid-invoices-have-payments",
      "label": "paid invoices whose payment is in the export",
      "from": {
        "table": "VPM2",
        "columns": [
          "DocNum"
        ]
      },
      "to": {
        "table": "OVPM",
        "columns": [
          "DocEntry"
        ]
      },
      "expect": "all"
    },
    {
      "id": "paid-invoices-are-exported",
      "label": "paid invoices that are in the export",
      "from": {
        "table": "VPM2",
        "columns": [
          "DocEntry"
        ],
        "where": [
          {
            "column": "InvType",
            "in": [
              "18"
            ]
          }
        ]
      },
      "to": {
        "table": "OPCH",
        "columns": [
          "DocEntry"
        ]
      },
      "expect": "all"
    }
  ],
  "recipe": {
    "version": 1,
    "format": "ocel",
    "objects": [
      {
        "id": "b1_p_request",
        "input": "OPRQ",
        "namespace": "sap-b1",
        "object_type": "purchase request",
        "key": [
          "DocEntry"
        ],
        "attributes": [
          {
            "column": "DocNum",
            "name": "number"
          }
        ],
        "where": [
          {
            "column": "CANCELED",
            "not_in": [
              "C"
            ]
          }
        ]
      },
      {
        "id": "b1_p_order",
        "input": "OPOR",
        "namespace": "sap-b1",
        "object_type": "purchase order",
        "key": [
          "DocEntry"
        ],
        "attributes": [
          {
            "column": "DocNum",
            "name": "number"
          },
          {
            "column": "CardCode",
            "name": "vendor"
          }
        ],
        "where": [
          {
            "column": "CANCELED",
            "not_in": [
              "C"
            ]
          }
        ]
      },
      {
        "id": "b1_p_order_line",
        "input": "POR1",
        "namespace": "sap-b1",
        "object_type": "purchase order line",
        "key": [
          "DocEntry",
          "LineNum"
        ],
        "attributes": [
          {
            "column": "ItemCode",
            "name": "item"
          },
          {
            "column": "Quantity",
            "name": "quantity"
          },
          {
            "column": "Price",
            "name": "price"
          }
        ]
      },
      {
        "id": "b1_p_receipt_line",
        "input": "PDN1",
