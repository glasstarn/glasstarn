{
  "id": "sap-business-one-purchase-to-pay",
  "version": 1,
  "name": "Purchase to pay (SAP Business One)",
  "system": "SAP Business One",
  "process": "purchase to pay",
  "status": "untested",
  "note": "Written by the Glasstarn project from public knowledge of the SAP Business One database tables. Not yet confirmed on a real company database; tested only on made-up tables in the standard layout. Approval steps need the approval procedures' tables (OWDD, WDD1); approval times are read as HHMMSS.",
  "case_object_type": "purchase order line",
  "size_check": {
    "ask": "How many purchase order lines were created in the period?",
    "unit": "purchase order line",
    "steps_per_unit": 4
  },
  "custom_prefixes": [
    "U_*"
  ],
  "settings": [
    {
      "id": "offset",
      "question": "What time zone is the SAP Business One server set to? Business One stores creation times without a time zone. Give it as an offset from UTC, for example +01:00.",
      "example": "+01:00"
    }
  ],
  "tables": [
    {
      "name": "OPRQ",
      "label": "Purchase requests",
      "export": "Purchase requests created in the period (OPRQ). Header fields DocEntry, DocNum, CardCode, DocDate, CreateDate, CreateTS, DocTotal, CANCELED and UserSign. Include cancellation documents (CANCELED = C) and their lines. Dates as YYYY-MM-DD; CreateTS as the stored number (HHMMSS). Leave BaseEntry and BaseLine blank on lines without a base document.",
      "required": [
        "DocEntry",
        "DocNum",
        "CardCode",
        "DocDate",
        "CreateDate",
        "CreateTS",
        "CANCELED"
      ],
      "fields": [
        "DocTotal",
        "UserSign",
        "DocStatus",
        "DocDueDate",
        "draftKey",
        "CancelDate"
      ],
      "date_field": "CreateDate",
      "object": "b1_p_request",
      "key": [
        "DocEntry"
      ],
      "optional": true
    },
    {
      "name": "PRQ1",
      "label": "Purchase request lines",
      "export": "The lines of those purchase requests (PRQ1). Fields DocEntry, LineNum, ItemCode, Quantity, Price, BaseType, BaseEntry and BaseLine.",
      "required": [
        "DocEntry",
        "LineNum",
        "ItemCode",
        "Quantity",
        "BaseType",
        "BaseEntry",
        "BaseLine"
      ],
      "fields": [
        "Price",
        "LineTotal",
        "LineStatus"
      ],
      "optional": true
    },
    {
      "name": "OPOR",
      "label": "Purchase orders",
      "export": "Purchase orders created in the period (OPOR). Header fields DocEntry, DocNum, CardCode, DocDate, CreateDate, CreateTS, DocTotal, CANCELED and UserSign. Include cancellation documents (CANCELED = C) and their lines. Dates as YYYY-MM-DD; CreateTS as the stored number (HHMMSS). Leave BaseEntry and BaseLine blank on lines without a base document.",
      "required": [
        "DocEntry",
        "DocNum",
        "CardCode",
        "DocDate",
        "CreateDate",
        "CreateTS",
        "CANCELED"
      ],
      "fields": [
        "DocTotal",
        "UserSign",
        "DocStatus",
        "DocDueDate",
        "draftKey",
        "CancelDate"
      ],
      "date_field": "CreateDate",
      "noun": "purchase orders",
      "date_label": "the order was created",
      "object": "b1_p_order",
      "key": [
        "DocEntry"
      ]
    },
    {
      "name": "POR1",
      "label": "Purchase order lines",
      "export": "The lines of those orders (POR1). Fields DocEntry, LineNum, ItemCode, Quantity, Price, BaseType, BaseEntry and BaseLine.",
      "required": [
        "DocEntry",
        "LineNum",
        "ItemCode",
        "Quantity",
        "BaseType",
        "BaseEntry",
        "BaseLine"
      ],
      "fields": [
        "Price",
        "LineTotal",
        "LineStatus"
      ],
      "noun": "purchase order lines",
      "object": "b1_p_order_line",
      "key": [
        "DocEntry",
        "LineNum"
      ]
    },
    {
      "name": "OPDN",
      "label": "Goods receipts",
      "export": "Goods receipts based on those orders (OPDN). Header fields DocEntry, DocNum, CardCode, DocDate, CreateDate, CreateTS, DocTotal, CANCELED and UserSign. Include cancellation documents (CANCELED = C) and their lines. Dates as YYYY-MM-DD; CreateTS as the stored number (HHMMSS). Leave BaseEntry and BaseLine blank on lines without a base document.",
      "required": [
        "DocEntry",
        "DocNum",
        "CardCode",
        "DocDate",
        "CreateDate",
        "CreateTS",
        "CANCELED"
      ],
      "fields": [
        "DocTotal",
        "UserSign",
        "DocStatus",
        "DocDueDate",
        "draftKey",
        "CancelDate"
      ],
      "date_field": "CreateDate"
    },
    {
      "name": "PDN1",
      "label": "Goods receipt lines",
      "export": "The lines of those documents (PDN1). Fields DocEntry, LineNum, ItemCode, Quantity, Price, BaseType, BaseEntry and BaseLine.",
      "required": [
        "DocEntry",
        "LineNum",
        "ItemCode",
        "Quantity",
        "BaseType",
        "BaseEntry",
        "BaseLine"
      ],
      "fields": [
        "Price",
        "LineTotal",
        "LineStatus"
      ],
      "object": "b1_p_receipt_line",
      "key": [
        "DocEntry",
        "LineNum"
      ]
    },
    {
      "name": "OPCH",
      "label": "Supplier invoices",
      "export": "Supplier invoices for those orders or documents (OPCH). Header fields DocEntry, DocNum, CardCode, DocDate, CreateDate, CreateTS, DocTotal, CANCELED and UserSign. Include cancellation documents (CANCELED = C) and their lines. Dates as YYYY-MM-DD; CreateTS as the stored number (HHMMSS). Leave BaseEntry and BaseLine blank on lines without a base document.",
      "required": [
        "DocEntry",
        "DocNum",
        "CardCode",
        "DocDate",
        "CreateDate",
        "CreateTS",
        "CANCELED"
      ],
      "fields": [
        "DocTotal",
        "UserSign",
        "DocStatus",
        "DocDueDate",
        "draftKey",
        "CancelDate"
      ],
      "date_field": "CreateDate",
      "noun": "supplier invoices",
      "object": "b1_p_invoice",
      "key": [
        "DocEntry"
      ]
    },
    {
      "name": "PCH1",
      "label": "Supplier invoice lines",
      "export": "The lines of those invoices (PCH1). Fields DocEntry, LineNum, ItemCode, Quantity, Price, BaseType, BaseEntry and BaseLine.",
      "required": [
        "DocEntry",
        "LineNum",
        "ItemCode",
        "Quantity",
        "BaseType",
        "BaseEntry",
        "BaseLine"
      ],
      "fields": [
        "Price",
        "LineTotal",
        "LineStatus"
      ]
    },
    {
      "name": "OVPM",
      "label": "Payments",
      "export": "Payments that pay those invoices (OVPM): DocEntry, DocNum, CardCode, DocDate, CreateDate, CreateTS, Canceled and DocTotal. Include cancellation documents (CANCELED = C) and their lines. Dates as YYYY-MM-DD; CreateTS as the stored number (HHMMSS). Leave BaseEntry and BaseLine blank on lines without a base document.",
      "required": [
        "DocEntry",
        "DocNum",
        "CardCode",
        "DocDate",
        "CreateDate",
        "CreateTS",
        "Canceled"
      ],
      "fields": [
        "DocTotal",
        "UserSign"
      ],
      "date_field": "CreateDate",
      "optional": true
    },
    {
      "name": "VPM2",
      "label": "Paid invoices",
      "export": "The invoices each of those payments pays (VPM2): DocNum (the payment's DocEntry), InvoiceId, DocEntry (the invoice), InvType and SumApplied.",
      "required": [
        "DocNum",
        "InvoiceId",
        "DocEntry",
        "InvType"
      ],
      "fields": [
        "SumApplied"
      ],
      "optional": true
    },
    {
      "name": "OWDD",
      "label": "Approval requests",
      "export": "Approval requests for purchase orders (OWDD, ObjType 22): WddCode, ObjType, DocEntry (the draft), Status, CreateDate and CreateTime (as HHMMSS).",
      "required": [
        "WddCode",
        "ObjType",
        "DocEntry",
        "Status",
        "CreateDate",
        "CreateTime"
      ],
      "fields": [
        "OwnerID"
      ],
      "date_field": "CreateDate",
      "optional": true
    },
    {
      "name": "WDD1",
      "label": "Approval decisions",
      "export": "The decisions on those requests (WDD1): WddCode, StepCode, UserID, Status (Y approved, N rejected), UpdateDate and UpdateTime (as HHMMSS).",
      "required": [
        "WddCode",
        "StepCode",
        "UserID",
        "Status",
        "UpdateDate",
        "UpdateTime"
      ],
      "fields": [],
      "date_field": "UpdateDate",
      "optional": true
    },
    {
      "name": "OCRD",
      "noun": "vendors",
      "label": "Vendors",
      "export": "The vendors on those documents (OCRD): CardCode, CardType, GroupCode, Country and the company's own fields. No names or contact details.",
      "required": [
        "CardCode",
        "CardType"
      ],
      "fields": [
        "GroupCode",
        "Country"
      ],
      "object": "b1_p_partner",
      "key": [
        "CardCode"
      ],
      "optional": true
    }
  ],
  "unique": [
