          "DocEntry",
          "LineNum"
        ],
        "attributes": [
          {
            "column": "ItemCode",
            "name": "item"
          },
          {
            "column": "Quantity",
            "name": "quantity"
          }
        ],
        "where": [
          {
            "column": "BaseType",
            "not_in": [
              "20"
            ]
          }
        ]
      },
      {
