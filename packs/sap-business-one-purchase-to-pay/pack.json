        "key": [
          "DocEntry"
        ],
        "attributes": [
          {
            "column": "DocNum",
            "name": "number"
          },
          {
            "column": "DocTotal",
            "name": "total"
          }
        ],
        "where": [
          {
            "column": "CANCELED",
            "not_in": [
              "C"
            ]
          }
        ]
      },
      {
        "id": "b1_p_partner",
        "input": "OCRD",
        "namespace": "sap-b1",
        "object_type": "vendor",
        "key": [
          "CardCode"
        ],
        "attributes": [
          {
            "column": "GroupCode",
            "name": "group"
          },
          {
            "column": "Country",
            "name": "country"
          }
        ]
      }
    ],
