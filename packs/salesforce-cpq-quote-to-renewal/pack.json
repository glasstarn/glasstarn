        },
        "timestamp": "CreatedDate",
        "objects": [
          {
            "object": "sf_cpq_contract",
            "columns": [
              "Id"
            ],
            "qualifier": "contract"
          },
          {
            "object": "sf_cpq_quote",
            "columns": [
              "SBQQ__Quote__c"
            ],
