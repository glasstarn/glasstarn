{
  "id": "salesforce-cpq-quote-to-renewal",
  "version": 1,
  "name": "Quote to renewal (Salesforce CPQ)",
  "system": "Salesforce CPQ (Salesforce Revenue Cloud managed package)",
  "process": "quote to renewal",
  "status": "tested",
  "note": "Written by the Glasstarn project from public knowledge of the Salesforce CPQ managed package objects (SBQQ namespace) and their links to orders, contracts and renewal opportunities. Checked on a real Salesforce org on 2026-10-15 with planted records; see the README. Quote status steps need field history tracking on SBQQ__Status__c; approvals made with Advanced Approvals appear as those status changes.",
  "case_object_type": "quote",
  "size_check": {
    "ask": "How many CPQ quotes were created in the period?",
    "unit": "quote",
    "steps_per_unit": 7
  },
  "custom_prefixes": [
    "*__c"
  ],
  "include": [
    "salesforce-opportunities"
  ],
  "tables": [
    {
      "name": "Opportunity",
      "noun": "opportunities",
      "date_label": "the opportunity was created",
      "label": "Salesforce opportunities",
      "export": "Opportunities for the period: Id, Name, AccountId, CreatedDate, StageName, IsClosed, IsWon, CloseDate, Amount, SBQQ__RenewedContract__c (the contract a renewal renews) and the company's own fields.",
      "required": [
        "Id",
        "CreatedDate",
        "StageName",
        "IsClosed",
        "IsWon",
        "CloseDate",
        "Amount"
      ],
      "fields": [
        "Name",
        "AccountId",
        "LeadSource",
        "OwnerId",
        "Probability",
        "Type",
        "SBQQ__RenewedContract__c"
      ],
      "date_field": "CreatedDate",
      "object": "sf_opportunity",
      "key": [
        "Id"
      ]
    },
    {
      "name": "SBQQ__Quote__c",
      "noun": "quotes",
      "date_label": "the quote was created",
      "label": "CPQ quotes",
      "export": "CPQ quotes created in the period: Id, Name, SBQQ__Opportunity2__c, CreatedDate, SBQQ__Status__c, SBQQ__Primary__c, SBQQ__NetAmount__c, SBQQ__Ordered__c and the company's own fields.",
      "required": [
        "Id",
        "SBQQ__Opportunity2__c",
        "CreatedDate",
        "SBQQ__Status__c",
        "SBQQ__Primary__c"
      ],
      "fields": [
        "Name",
        "SBQQ__NetAmount__c",
        "SBQQ__Ordered__c",
        "SBQQ__Type__c"
      ],
      "date_field": "CreatedDate",
      "object": "sf_cpq_quote",
      "key": [
        "Id"
      ]
    },
    {
      "name": "SBQQ__Quote__History",
      "label": "CPQ quote field history",
      "export": "Field history of those quotes (SBQQ__Quote__History): Id, ParentId, Field, OldValue, NewValue, CreatedDate and DataType.",
      "required": [
        "Id",
        "ParentId",
        "Field",
        "OldValue",
        "NewValue",
        "CreatedDate"
      ],
      "fields": [
        "DataType",
        "CreatedById"
      ],
      "date_field": "CreatedDate",
      "history_of": "SBQQ__Quote__c",
      "needs_tracked": [
        "SBQQ__Status__c"
      ]
    },
    {
      "name": "Order",
      "label": "Orders",
      "export": "Orders created from those quotes: Id, SBQQ__Quote__c, CreatedDate, Status and ActivatedDate.",
      "required": [
        "Id",
        "SBQQ__Quote__c",
        "CreatedDate",
        "ActivatedDate"
      ],
      "fields": [
        "Status",
        "OrderNumber",
        "TotalAmount"
      ],
      "date_field": "CreatedDate",
      "optional": true
    },
    {
      "name": "Contract",
      "noun": "contracts",
      "label": "Contracts",
      "export": "Contracts created from those quotes or orders: Id, SBQQ__Quote__c, SBQQ__Order__c, CreatedDate, StartDate, EndDate, ActivatedDate and Status.",
      "required": [
        "Id",
        "SBQQ__Quote__c",
        "CreatedDate",
        "StartDate",
        "EndDate",
        "ActivatedDate"
      ],
      "fields": [
        "SBQQ__Order__c",
        "Status",
        "ContractNumber",
        "SBQQ__RenewalOpportunity__c"
      ],
      "date_field": "CreatedDate",
      "object": "sf_cpq_contract",
      "key": [
        "Id"
      ],
      "optional": true
    }
  ],
  "unique": [
    {
      "id": "one-cpq-quote",
      "table": "SBQQ__Quote__c",
      "columns": [
        "Id"
      ],
      "label": "quotes listed once"
    },
    {
      "id": "one-cpq-quote-history-row",
      "table": "SBQQ__Quote__History",
      "columns": [
        "Id"
      ],
      "label": "quote history rows listed once"
    },
    {
      "id": "one-cpq-order",
      "table": "Order",
      "columns": [
        "Id"
      ],
      "label": "orders listed once"
    },
    {
      "id": "one-cpq-contract",
      "table": "Contract",
      "columns": [
        "Id"
      ],
      "label": "contracts listed once"
    }
  ],
  "checks": [
    {
      "id": "cpq-history-has-quotes",
      "label": "quote history rows whose quote is in the export",
      "from": {
        "table": "SBQQ__Quote__History",
        "columns": [
          "ParentId"
        ]
      },
      "to": {
        "table": "SBQQ__Quote__c",
        "columns": [
          "Id"
        ]
      },
      "expect": "all"
    },
    {
      "id": "cpq-orders-have-quotes",
      "label": "orders whose quote is in the export",
      "from": {
        "table": "Order",
        "columns": [
          "SBQQ__Quote__c"
        ],
        "where": [
          {
            "column": "SBQQ__Quote__c",
            "not_in": [
              ""
            ]
          }
        ]
      },
      "to": {
        "table": "SBQQ__Quote__c",
        "columns": [
          "Id"
        ]
      },
      "expect": "all"
    },
    {
      "id": "cpq-contracts-have-quotes",
      "label": "contracts whose quote is in the export",
      "from": {
        "table": "Contract",
        "columns": [
          "SBQQ__Quote__c"
        ],
        "where": [
          {
            "column": "SBQQ__Quote__c",
            "not_in": [
              ""
            ]
          }
        ]
      },
      "to": {
        "table": "SBQQ__Quote__c",
        "columns": [
          "Id"
        ]
      },
      "expect": "all"
    }
  ],
  "recipe": {
    "objects": [
      {
        "id": "sf_cpq_quote",
        "input": "SBQQ__Quote__c",
        "namespace": "salesforce",
        "object_type": "quote",
