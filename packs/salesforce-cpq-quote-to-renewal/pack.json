        ],
        "activity": {
          "value": "Activate contract"
        },
        "timestamp": "ActivatedDate",
        "optional_timestamp": true,
        "objects": [
          {
            "object": "sf_cpq_contract",
            "columns": [
              "Id"
            ],
            "qualifier": "contract"
          },
          {
            "object": "sf_cpq_quote",
            "columns": [
              "SBQQ__Quote__c"
            ],
            "qualifier": "quote",
            "optional": true,
