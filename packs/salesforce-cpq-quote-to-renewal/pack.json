          "Id"
        ],
        "attributes": [
          {
            "column": "SBQQ__Status__c",
            "name": "status"
          },
          {
            "column": "SBQQ__Primary__c",
            "name": "primary"
          },
          {
            "column": "SBQQ__NetAmount__c",
            "name": "net amount"
          }
        ]
      },
      {
        "id": "sf_cpq_contract",
        "input": "Contract",
        "namespace": "salesforce",
        "object_type": "contract",
        "key": [
          "Id"
        ],
        "attributes": [
          {
            "column": "StartDate",
            "name": "start date"
          },
          {
            "column": "EndDate",
            "name": "end date"
          }
        ]
      }
    ],
    "events": [
      {
        "id": "sf_cpq_quote_created",
        "input": "SBQQ__Quote__c",
        "namespace": "salesforce",
        "key": [
          "Id"
        ],
        "activity": {
          "value": "Create quote"
        },
        "timestamp": "CreatedDate",
        "attributes": [
          {
            "column": "SBQQ__NetAmount__c",
            "name": "net amount"
          }
        ],
        "objects": [
          {
            "object": "sf_cpq_quote",
            "columns": [
              "Id"
            ],
            "qualifier": "quote"
          },
          {
            "object": "sf_opportunity",
            "columns": [
              "SBQQ__Opportunity2__c"
            ],
            "qualifier": "opportunity",
            "optional": true,
            "allow_unmatched": true
          }
        ]
      },
      {
        "id": "sf_cpq_quote_status_changed",
        "input": "SBQQ__Quote__History",
        "namespace": "salesforce",
        "key": [
          "Id"
        ],
        "where": [
          {
            "column": "Field",
            "in": [
              "SBQQ__Status__c"
            ]
          }
        ],
        "activity": {
          "column": "NewValue",
          "prefix": "Quote: "
        },
        "timestamp": "CreatedDate",
        "attributes": [
          {
            "column": "OldValue",
            "name": "old value"
          },
          {
            "column": "NewValue",
            "name": "new value"
          }
        ],
        "objects": [
          {
            "object": "sf_cpq_quote",
            "columns": [
              "ParentId"
            ],
            "qualifier": "quote"
          }
        ]
      },
      {
        "id": "sf_cpq_order_created",
        "input": "Order",
        "namespace": "salesforce",
        "key": [
          "Id"
        ],
        "where": [
          {
            "column": "SBQQ__Quote__c",
            "not_in": [
              ""
            ]
          }
        ],
        "activity": {
          "value": "Create order"
        },
        "timestamp": "CreatedDate",
        "attributes": [
          {
            "column": "TotalAmount",
            "name": "total amount"
          }
        ],
        "objects": [
          {
            "object": "sf_cpq_quote",
            "columns": [
              "SBQQ__Quote__c"
            ],
            "qualifier": "quote"
          }
        ]
      },
      {
