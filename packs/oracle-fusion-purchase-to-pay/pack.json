      "columns": [
        "INVOICE_PAYMENT_ID"
      ],
      "label": "invoice payments listed once"
    }
  ],
  "checks": [
    {
      "id": "lines-have-orders",
      "label": "order lines whose order is in the export",
      "from": {
        "table": "PO_LINES_ALL",
        "columns": [
          "PO_HEADER_ID"
        ]
      },
      "to": {
        "table": "PO_HEADERS_ALL",
        "columns": [
          "PO_HEADER_ID"
        ]
      },
      "expect": "all"
    },
    {
      "id": "approvals-have-orders",
      "label": "approval actions whose order is in the export",
      "from": {
        "table": "PO_ACTION_HISTORY",
        "columns": [
          "OBJECT_ID"
        ],
        "where": [
          {
            "column": "OBJECT_TYPE_CODE",
            "in": [
              "PO"
            ]
          }
        ]
      },
      "to": {
        "table": "PO_HEADERS_ALL",
        "columns": [
          "PO_HEADER_ID"
        ]
      },
      "expect": "all"
    },
    {
      "id": "receipts-have-lines",
      "label": "receiving transactions whose order line is in the export",
      "from": {
        "table": "RCV_TRANSACTIONS",
        "columns": [
          "PO_LINE_ID"
        ]
      },
      "to": {
        "table": "PO_LINES_ALL",
        "columns": [
          "PO_LINE_ID"
        ]
      },
      "expect": "all"
    },
    {
      "id": "invoice-lines-have-invoices",
      "label": "invoice lines whose invoice is in the export",
      "from": {
        "table": "AP_INVOICE_LINES_ALL",
        "columns": [
          "INVOICE_ID"
        ]
      },
      "to": {
        "table": "AP_INVOICES_ALL",
        "columns": [
          "INVOICE_ID"
        ]
      },
      "expect": "all"
    },
    {
      "id": "invoice-lines-have-order-lines",
      "label": "invoice lines matched to an order line in the export",
      "from": {
        "table": "AP_INVOICE_LINES_ALL",
        "columns": [
          "PO_LINE_ID"
        ],
        "where": [
          {
            "column": "PO_LINE_ID",
            "not_in": [
              ""
            ]
          }
        ]
      },
      "to": {
        "table": "PO_LINES_ALL",
        "columns": [
          "PO_LINE_ID"
        ]
      },
      "expect": "most",
      "threshold": 0.95,
      "question": {
        "text": "{missing} of {total} invoice lines are matched to orders created before the period. Keep them without their order, or re-export with the older orders?",
        "options": [
          {
            "id": "keep",
            "label": "Keep them without their order"
          },
          {
            "id": "re-export",
            "label": "Re-export with the older orders"
          }
        ],
        "recommended": "keep"
      }
    },
    {
      "id": "holds-have-invoices",
      "label": "holds whose invoice is in the export",
      "from": {
        "table": "AP_HOLDS_ALL",
        "columns": [
          "INVOICE_ID"
        ]
      },
      "to": {
        "table": "AP_INVOICES_ALL",
        "columns": [
          "INVOICE_ID"
        ]
      },
      "expect": "all"
    },
    {
      "id": "payments-have-invoices",
      "label": "payments whose invoice is in the export",
      "from": {
        "table": "AP_INVOICE_PAYMENTS_ALL",
        "columns": [
          "INVOICE_ID"
        ]
      },
      "to": {
        "table": "AP_INVOICES_ALL",
        "columns": [
          "INVOICE_ID"
        ]
      },
      "expect": "all"
    },
    {
      "id": "requisitions-have-shipments",
      "label": "requisition lines whose order shipment is in the export",
      "from": {
        "table": "PO_REQUISITION_LINES_ALL",
        "columns": [
          "LINE_LOCATION_ID"
        ],
        "where": [
          {
            "column": "LINE_LOCATION_ID",
            "not_in": [
              ""
            ]
          }
        ]
      },
      "to": {
        "table": "PO_LINE_LOCATIONS_ALL",
        "columns": [
          "LINE_LOCATION_ID"
        ]
      },
      "expect": "all"
    }
  ],
