{
  "id": "oracle-fusion-purchase-to-pay",
  "version": 1,
  "name": "Purchase to pay (Oracle Fusion Cloud)",
  "system": "Oracle Fusion Cloud Procurement and Payables",
  "process": "purchase to pay",
  "status": "untested",
  "note": "Written by the Glasstarn project from public knowledge of the Oracle Purchasing, Receiving and Payables tables. Not yet confirmed on a real system; tested only on made-up tables in the standard layout.",
  "case_object_type": "purchase order line",
  "size_check": {
    "ask": "How many purchase order lines were created in the period for the operating unit?",
    "unit": "purchase order line",
    "steps_per_unit": 5
  },
  "custom_prefixes": [
    "ATTRIBUTE*"
  ],
  "settings": [
    {
      "id": "offset",
      "question": "Oracle Fusion Cloud stores times in UTC; answer Z unless the extract converted them. Give it as an offset from UTC, for example Z or +01:00.",
      "example": "Z"
    }
  ],
  "tables": [
    {
      "name": "PO_HEADERS_ALL",
      "noun": "purchase orders",
      "date_label": "the order was created",
      "label": "Purchase orders",
      "export": "Standard purchase orders created in the period for the operating unit (filter ORG_ID, TYPE_LOOKUP_CODE STANDARD, CREATION_DATE). Extract with BI Publisher (SQL on the tables below) or BI Cloud Connector. Dates with their time, as YYYY-MM-DD HH:MM:SS.",
      "required": [
        "PO_HEADER_ID",
        "SEGMENT1",
        "VENDOR_ID",
        "ORG_ID",
        "CREATION_DATE",
        "AUTHORIZATION_STATUS",
        "TYPE_LOOKUP_CODE"
      ],
      "fields": [
        "APPROVED_DATE",
        "CREATED_BY",
        "CURRENCY_CODE"
      ],
      "date_field": "CREATION_DATE",
      "object": "ora_po",
      "key": [
        "PO_HEADER_ID"
      ],
      "scope_field": "ORG_ID"
    },
    {
      "name": "PO_LINES_ALL",
      "noun": "purchase order lines",
      "label": "Purchase order lines",
      "export": "The lines of those orders: PO_LINE_ID, PO_HEADER_ID, LINE_NUM, ITEM_ID, QUANTITY, UNIT_PRICE, CREATION_DATE, CANCEL_FLAG and CANCEL_DATE.",
      "required": [
        "PO_LINE_ID",
        "PO_HEADER_ID",
        "LINE_NUM",
        "QUANTITY",
        "CREATION_DATE",
        "CANCEL_FLAG",
        "CANCEL_DATE"
      ],
      "fields": [
        "ITEM_ID",
        "UNIT_PRICE",
        "CATEGORY_ID"
      ],
      "object": "ora_po_line",
      "key": [
        "PO_LINE_ID"
      ]
    },
    {
      "name": "PO_ACTION_HISTORY",
      "label": "Approval history",
      "export": "Approval actions on those orders (OBJECT_TYPE_CODE PO): OBJECT_ID, OBJECT_TYPE_CODE, SEQUENCE_NUM, ACTION_CODE, ACTION_DATE and EMPLOYEE_ID.",
      "required": [
        "OBJECT_ID",
        "OBJECT_TYPE_CODE",
        "SEQUENCE_NUM",
        "ACTION_CODE",
        "ACTION_DATE"
      ],
      "fields": [
        "EMPLOYEE_ID"
      ],
      "date_field": "ACTION_DATE",
      "optional": true
    },
    {
      "name": "PO_REQUISITION_LINES_ALL",
      "label": "Requisition lines",
      "export": "Requisition lines that became those order lines: REQUISITION_LINE_ID, REQUISITION_HEADER_ID, LINE_LOCATION_ID, CREATION_DATE and QUANTITY.",
      "required": [
        "REQUISITION_LINE_ID",
        "REQUISITION_HEADER_ID",
        "LINE_LOCATION_ID",
        "CREATION_DATE"
      ],
      "fields": [
        "QUANTITY",
        "ITEM_ID"
      ],
      "date_field": "CREATION_DATE",
      "optional": true
    },
    {
      "name": "PO_LINE_LOCATIONS_ALL",
      "label": "Order shipments",
      "export": "The shipments of those order lines: LINE_LOCATION_ID, PO_LINE_ID and PO_HEADER_ID.",
      "required": [
        "LINE_LOCATION_ID",
        "PO_LINE_ID",
        "PO_HEADER_ID"
      ],
      "fields": [
        "NEED_BY_DATE",
        "PROMISED_DATE"
      ],
      "optional": true
    },
    {
      "name": "RCV_TRANSACTIONS",
      "label": "Receiving transactions",
      "export": "Receiving transactions for those orders: TRANSACTION_ID, TRANSACTION_TYPE, TRANSACTION_DATE, PO_HEADER_ID, PO_LINE_ID and QUANTITY. Dates with their time, as YYYY-MM-DD HH:MM:SS.",
      "required": [
        "TRANSACTION_ID",
        "TRANSACTION_TYPE",
        "TRANSACTION_DATE",
        "PO_HEADER_ID",
        "PO_LINE_ID",
        "QUANTITY"
      ],
      "fields": [
        "CREATION_DATE"
      ],
      "date_field": "TRANSACTION_DATE"
    },
    {
      "name": "AP_INVOICES_ALL",
      "noun": "supplier invoices",
      "label": "Supplier invoices",
      "export": "Supplier invoices for those orders: INVOICE_ID, INVOICE_NUM, VENDOR_ID, INVOICE_DATE, CREATION_DATE, INVOICE_AMOUNT, CANCELLED_DATE and ORG_ID. Dates with their time, as YYYY-MM-DD HH:MM:SS.",
      "required": [
        "INVOICE_ID",
        "INVOICE_NUM",
        "VENDOR_ID",
        "CREATION_DATE",
        "INVOICE_AMOUNT",
        "CANCELLED_DATE"
      ],
      "fields": [
        "INVOICE_DATE",
        "ORG_ID",
        "INVOICE_CURRENCY_CODE"
      ],
      "date_field": "CREATION_DATE",
      "object": "ora_invoice",
      "key": [
        "INVOICE_ID"
      ]
    },
    {
      "name": "AP_INVOICE_LINES_ALL",
      "label": "Supplier invoice lines",
      "export": "The lines of those invoices: INVOICE_ID, LINE_NUMBER, LINE_TYPE_LOOKUP_CODE, PO_HEADER_ID, PO_LINE_ID and AMOUNT.",
      "required": [
        "INVOICE_ID",
        "LINE_NUMBER",
        "LINE_TYPE_LOOKUP_CODE",
        "PO_HEADER_ID",
        "PO_LINE_ID"
      ],
      "fields": [
        "AMOUNT"
      ]
    },
    {
      "name": "AP_HOLDS_ALL",
      "label": "Invoice holds",
      "export": "Holds on those invoices: HOLD_ID, INVOICE_ID, HOLD_LOOKUP_CODE, HOLD_DATE, RELEASE_LOOKUP_CODE and LAST_UPDATE_DATE.",
      "required": [
        "HOLD_ID",
        "INVOICE_ID",
        "HOLD_LOOKUP_CODE",
        "HOLD_DATE",
        "RELEASE_LOOKUP_CODE",
        "LAST_UPDATE_DATE"
      ],
      "fields": [],
      "date_field": "HOLD_DATE",
      "optional": true
    },
    {
      "name": "AP_INVOICE_PAYMENTS_ALL",
      "label": "Invoice payments",
      "export": "Payments of those invoices: INVOICE_PAYMENT_ID, INVOICE_ID, CHECK_ID, AMOUNT, CREATION_DATE and REVERSAL_FLAG. Dates with their time, as YYYY-MM-DD HH:MM:SS.",
      "required": [
        "INVOICE_PAYMENT_ID",
        "INVOICE_ID",
        "CHECK_ID",
        "CREATION_DATE",
        "REVERSAL_FLAG"
      ],
      "fields": [
        "AMOUNT",
        "ACCOUNTING_DATE"
      ],
      "date_field": "CREATION_DATE",
      "optional": true
    }
  ],
